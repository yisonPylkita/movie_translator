{
  "subagents": {
    "defaultModel": "deepseek/deepseek-v4-flash",
    "maxSubagentDepth": 2,
    "modelScope": {
      "enforce": true,
      "allow": [
        "deepseek/deepseek-v4-flash",
        "deepseek/deepseek-v4-pro"
      ]
    },
    "agentOverrides": {
      "worker": { "model": "deepseek/deepseek-v4-flash", "thinking": "medium" },
      "scout": { "model": "deepseek/deepseek-v4-flash", "thinking": "low" },
      "delegate": { "model": "deepseek/deepseek-v4-flash", "thinking": "low" },
      "planner": { "model": "deepseek/deepseek-v4-flash", "thinking": "medium" },
      "context-builder": { "model": "deepseek/deepseek-v4-flash", "thinking": "low" },
      "researcher": { "model": "deepseek/deepseek-v4-flash", "thinking": "low" },
      "reviewer": { "model": "deepseek/deepseek-v4-flash", "thinking": "medium" },
      "oracle": { "model": "deepseek/deepseek-v4-flash", "thinking": "low" }
    }
  }
}
