 "segments": [
  {
   "start_ms": 0,
   "end_ms": 4000,
   "text": "We knew the world would not be the same."
  },
  {
   "start_ms": 4000,
   "end_ms": 9000,
   "text": "Few people laughed."
  },
  {
   "start_ms": 9000,
   "end_ms": 11000,
   "text": "Few people cried."
  },
  {
   "start_ms": 11000,
   "end_ms": 16000,
   "text": "Most people were silent."
  },
  {
   "start_ms": 16000,
   "end_ms": 25000,
   "text": "I remembered the line from the Hindu scripture, the Bhagavad Gita."
  },
  {
   "start_ms": 25000,
   "end_ms": 35000,
   "text": "Vishnu is trying to persuade the prince that he should do his duty."
  },
  {
   "start_ms": 35000,
   "end_ms": 43000,
   "text": "And to impress him, takes on his multi-armed form and says,"
  },
  {
   "start_ms": 43000,
   "end_ms": 50000,
   "text": "\"Now I am become death, the destroyer of worlds.\""
  },
  {
   "start_ms": 50000,
   "end_ms": 53000,
   "text": "I suppose we all thought that one way or another."
  }
 ],
