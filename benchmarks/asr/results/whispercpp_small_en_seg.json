{
 "engine": "whisper.cpp",
 "model": "small",
 "lang": "en",
 "wav": "en_seg.wav",
 "segments": [
  {
   "start_ms": 0,
   "end_ms": 1000,
   "text": "[door closes]"
  },
  {
   "start_ms": 1000,
   "end_ms": 9000,
   "text": "You're Takafumi, my sister's kid."
  },
  {
   "start_ms": 9000,
   "end_ms": 11000,
   "text": "But where is..."
  },
  {
   "start_ms": 11000,
   "end_ms": 13500,
   "text": "everyone else?"
  },
  {
   "start_ms": 13500,
   "end_ms": 19200,
   "text": "Well, our family had a huge falling out because of you."
  },
  {
   "start_ms": 19200,
   "end_ms": 23600,
   "text": "What to do with you while you were in a coma, and let me tell you, it wasn't cheap."
  },
  {
   "start_ms": 23600,
   "end_ms": 26100,
   "text": "My mom said..."
  },
  {
   "start_ms": 26100,
   "end_ms": 28000,
   "text": "she didn't want to see you."
  },
  {
   "start_ms": 30500,
   "end_ms": 31500,
   "text": "[sniffles]"
  },
  {
   "start_ms": 31500,
   "end_ms": 34500,
   "text": "Ikura's Kura."
  },
  {
   "start_ms": 34500,
   "end_ms": 36400,
   "text": "[sighs]"
  },
  {
   "start_ms": 36400,
   "end_ms": 38700,
   "text": "Okay."
  },
  {
   "start_ms": 38700,
   "end_ms": 42100,
   "text": "I'll prove Grumbahamal is real."
  },
  {
   "start_ms": 42100,
   "end_ms": 44700,
   "text": "Uh, you really don't..."
  },
  {
   "start_ms": 44700,
   "end_ms": 47400,
   "text": "Wargrant Seld!"
  },
  {
   "start_ms": 47400,
   "end_ms": 51500,
   "text": "Okay."
  },
  {
   "start_ms": 51500,
   "end_ms": 53800,
   "text": "Wargrant Magna!"
  },
  {
   "start_ms": 53800,
   "end_ms": 58400,
   "text": "Wargrant Rald?"
  },
  {
   "start_ms": 58700,
   "end_ms": 60700,
   "text": "This is... just sad."
  },
  {
   "start_ms": 60700,
   "end_ms": 62400,
   "text": "Wargrant Gant!"
  },
  {
   "start_ms": 62400,
   "end_ms": 63900,
   "text": "Wargrant Pat!"
  },
  {
   "start_ms": 63900,
   "end_ms": 64900,
   "text": "Hey, Uncle..."
  },
  {
   "start_ms": 64900,
   "end_ms": 67900,
   "text": "Money has been a little tight lately,"
  },
  {
   "start_ms": 67900,
   "end_ms": 70900,
   "text": "so I brought some documents for you to sign."
  },
  {
   "start_ms": 70900,
   "end_ms": 75400,
   "text": "And after that, they're going to send you somewhere to help you get back to your feet."
  },
  {
   "start_ms": 75400,
   "end_ms": 76400,
   "text": "William, carry him."
  },
  {
   "start_ms": 76400,
   "end_ms": 85000,
   "text": "[gasps]"
  },
  {
   "start_ms": 85000,
   "end_ms": 87000,
   "text": "What the hell?!"
  },
  {
   "start_ms": 87400,
   "end_ms": 88900,
   "text": "When... return it."
  },
  {
   "start_ms": 88900,
   "end_ms": 93200,
   "text": "Of course, it's Japanese here."
  },
  {
   "start_ms": 93200,
   "end_ms": 97600,
   "text": "[gasps]"
  },
  {
   "start_ms": 97600,
   "end_ms": 109600,
   "text": "It's all real!"
  },
  {
   "start_ms": 109600,
   "end_ms": 112600,
   "text": "Hold on now."
  },
  {
   "start_ms": 112600,
   "end_ms": 115900,
   "text": "Did you just say you were sending me away somewhere?"
  },
  {
   "start_ms": 115900,
   "end_ms": 117100,
   "text": "No, I didn't."
  },
  {
   "start_ms": 117800,
   "end_ms": 118600,
   "text": "Yes, you were."
  },
  {
   "start_ms": 118600,
   "end_ms": 120100,
   "text": "Yeah, yeah, so what was that?"
  },
  {
   "start_ms": 120100,
   "end_ms": 121100,
   "text": "Hmm."
  },
  {
   "start_ms": 121100,
   "end_ms": 122300,
   "text": "It's magic."
  },
  {
   "start_ms": 122300,
   "end_ms": 124100,
   "text": "Fire."
  },
  {
   "start_ms": 124100,
   "end_ms": 126200,
   "text": "Whoa, awesome!"
  },
  {
   "start_ms": 126200,
   "end_ms": 127700,
   "text": "Wait, how are you doing that?"
  },
  {
   "start_ms": 127700,
   "end_ms": 128900,
   "text": "That's nothing."
  },
  {
   "start_ms": 128900,
   "end_ms": 131700,
   "text": "I want to know Sega when the console wars."
  },
  {
   "start_ms": 131700,
   "end_ms": 132700,
   "text": "Huh?"
  },
  {
   "start_ms": 132700,
   "end_ms": 133700,
   "text": "Sega?"
  },
  {
   "start_ms": 133700,
   "end_ms": 135700,
   "text": "The... now?"
  },
  {
   "start_ms": 135700,
   "end_ms": 140500,
   "text": "Well, these days, Sony and Nintendo are the biggest console makers."
  },
  {
   "start_ms": 140500,
   "end_ms": 142000,
   "text": "Huh? No Sega?"
  },
  {
   "start_ms": 142000,
   "end_ms": 143700,
   "text": "Is... this some sort of..."
  },
  {
   "start_ms": 143700,
   "end_ms": 145000,
   "text": "Sega!"
  },
  {
   "start_ms": 145800,
   "end_ms": 149100,
   "text": "Well, they, uh, stopped making consoles."
  },
  {
   "start_ms": 149100,
   "end_ms": 154600,
   "text": "Ikura's Kura."
  },
  {
   "start_ms": 154600,
   "end_ms": 159100,
   "text": "Hey, uncle, what's Ikura's Kura mean?"
  },
  {
   "start_ms": 159100,
   "end_ms": 162700,
   "text": "Oh, it's a memory erasing spell."
  },
  {
   "start_ms": 162700,
   "end_ms": 165300,
   "text": "So I can forget sad things."
  },
  {
   "start_ms": 165300,
   "end_ms": 168300,
   "text": "Sega was that important?"
  },
  {
   "start_ms": 168300,
   "end_ms": 171300,
   "text": "There were a lot of sad times in Grand Bahamul."
  },
  {
   "start_ms": 171300,
   "end_ms": 172600,
   "text": "Wanna see?"
  },
  {
   "start_ms": 172600,
   "end_ms": 174300,
   "text": "Uh, yeah."
  },
  {
   "start_ms": 175800,
   "end_ms": 178380,
   "text": "(upbeat music)"
  }
 ],
