  },
  {
   "start_ms": 585720,
   "end_ms": 587720,
   "text": "Before I drank"
  },
  {
   "start_ms": 587720,
   "end_ms": 590720,
   "text": "She was just really mean to me every day, alright?"
  },
  {
   "start_ms": 590720,
   "end_ms": 593720,
