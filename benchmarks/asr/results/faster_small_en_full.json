  {
   "start_ms": 547720,
   "end_ms": 549720,
   "text": "Tell me this later"
  },
  {
   "start_ms": 549720,
   "end_ms": 552720,
   "text": "She would show up every day to harass me to my face"
  },
  {
   "start_ms": 552720,
   "end_ms": 554720,
   "text": "No matter what I did to prove myself"
