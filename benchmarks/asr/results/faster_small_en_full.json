  {
   "start_ms": 599720,
   "end_ms": 601720,
   "text": "Don't touch me"
  },
  {
   "start_ms": 601720,
   "end_ms": 603720,
   "text": "I don't need your help"
  },
  {
   "start_ms": 604720,
   "end_ms": 607720,
