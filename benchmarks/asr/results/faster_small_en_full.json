  },
  {
   "start_ms": 517720,
   "end_ms": 519720,
   "text": "Oh, really?"
  },
  {
   "start_ms": 519720,
   "end_ms": 521720,
   "text": "Must have been hideous"
  },
  {
   "start_ms": 530720,
   "end_ms": 534720,
   "text": "They hunted me down like I was an orc"
