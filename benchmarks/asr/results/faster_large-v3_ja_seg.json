 "segments": [
  {
   "start_ms": 0,
   "end_ms": 8540,
   "text": "姉ちゃんの子供のタカフミか"
  },
  {
   "start_ms": 8540,
   "end_ms": 10820,
   "text": "大きくなったな"
  },
  {
   "start_ms": 10820,
   "end_ms": 13180,
   "text": "他のみんなは"
  },
  {
   "start_ms": 16360,
   "end_ms": 18960,
   "text": "渾水状態のおじさんの処遇をめぐって"
  },
  {
   "start_ms": 18960,
   "end_ms": 22100,
   "text": "言っちゃいけないことをボロクソ言い合った挙句"
  },
  {
   "start_ms": 22100,
   "end_ms": 23620,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 23620,
   "end_ms": 28020,
   "text": "うちの母さんも正直会いたくないって"
  },
  {
   "start_ms": 28020,
   "end_ms": 34280,
   "text": "イキュラス・キュオラ"
  },
  {
   "start_ms": 34280,
   "end_ms": 38440,
   "text": "さて"
  },
  {
   "start_ms": 38440,
   "end_ms": 42460,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 42460,
   "end_ms": 44420,
   "text": "え?いや、いいです"
  },
  {
   "start_ms": 44420,
   "end_ms": 46960,
   "text": "ワーグレント・セルド"
  },
  {
   "start_ms": 46960,
   "end_ms": 50879,
   "text": "あれ"
  },
  {
   "start_ms": 50879,
   "end_ms": 53480,
   "text": "ワーグレント・マグナ"
  },
  {
   "start_ms": 53480,
   "end_ms": 58000,
   "text": "ワーグレント・"
  },
  {
   "start_ms": 58000,
   "end_ms": 58019,
   "text": "ワーグレント・マグナ"
  },
  {
   "start_ms": 58020,
   "end_ms": 60780,
   "text": "ホント… 強いな"
  },
  {
   "start_ms": 60900,
   "end_ms": 63480,
   "text": "ワーグレント・ガッド ワーグレント・パッド"
  },
  {
   "start_ms": 63600,
   "end_ms": 65400,
   "text": "あ… あのさ…"
  },
  {
   "start_ms": 65520,
   "end_ms": 68400,
   "text": "不景気で うちも厳しくてさ"
  },
  {
   "start_ms": 68520,
   "end_ms": 71280,
   "text": "俺も いろいろあって バイトしてるし"
  },
  {
   "start_ms": 71400,
   "end_ms": 74280,
   "text": "自立支援とか あれする書類を 持ってきたんだけど…"
  },
  {
   "start_ms": 74420,
   "end_ms": 76000,
   "text": "課税を運べ"
  },
  {
   "start_ms": 81620,
   "end_ms": 83340,
   "text": "はあ…"
  },
  {
   "start_ms": 83460,
   "end_ms": 85300,
   "text": "はあ…"
  },
  {
   "start_ms": 85420,
   "end_ms": 86800,
   "text": "マジかよ!"
  },
  {
   "start_ms": 86800,
   "end_ms": 88380,
   "text": "課税を戻せ"
  },
  {
   "start_ms": 90600,
   "end_ms": 93100,
   "text": "こっちじゃ 日本語なんだな"
  },
  {
   "start_ms": 95220,
   "end_ms": 96259,
   "text": "はあ…"
  },
  {
   "start_ms": 107900,
   "end_ms": 109400,
   "text": "本物だ!"
  },
  {
   "start_ms": 111320,
   "end_ms": 115539,
   "text": "というか なんか 結構 エグいことを 言おうとしてなかった?"
  },
  {
   "start_ms": 115660,
   "end_ms": 116660,
   "text": "言ってないよ"
  },
  {
   "start_ms": 116660,
   "end_ms": 118280,
   "text": "ほんと?"
  },
  {
   "start_ms": 118420,
   "end_ms": 119660,
   "text": "それより さっきの 何?"
  },
  {
   "start_ms": 119780,
   "end_ms": 122119,
   "text": "あ… 魔法だよ"
  },
  {
   "start_ms": 122960,
   "end_ms": 123660,
   "text": "火を"
  },
  {
   "start_ms": 124840,
   "end_ms": 126039,
   "text": "うわっ すごい!"
  },
  {
   "start_ms": 126160,
   "end_ms": 127500,
   "text": "それ どうやって 出してるの?"
  },
  {
   "start_ms": 127620,
   "end_ms": 130680,
   "text": "そんなことより ゲームハードセンスは どうなった?"
  },
  {
   "start_ms": 130800,
   "end_ms": 131500,
   "text": "セガは?"
  },
  {
   "start_ms": 131640,
   "end_ms": 133680,
   "text": "え? セガ?"
  },
  {
   "start_ms": 133800,
   "end_ms": 135340,
   "text": "い… 今?"
  },
  {
   "start_ms": 136140,
   "end_ms": 140440,
   "text": "国内だと ソニーとニンテンドーが 二強って感じかな?"
  },
  {
   "start_ms": 140560,
   "end_ms": 142220,
   "text": "はあ? セガは?"
  },
  {
   "start_ms": 142359,
   "end_ms": 143519,
   "text": "ねえ それ 今 聞くこと…"
  },
  {
   "start_ms": 143640,
   "end_ms": 144780,
   "text": "セガは?"
  },
  {
   "start_ms": 145680,
   "end_ms": 146359,
   "text": "いや…"
  },
  {
   "start_ms": 147200,
   "end_ms": 149040,
   "text": "とっくに 撤退したけど…"
  },
  {
   "start_ms": 153000,
   "end_ms": 154420,
   "text": "イキュラスキオラ"
  },
  {
   "start_ms": 156220,
   "end_ms": 159220,
   "text": "ねえ その イキュラスキオラって 何?"
  },
  {
   "start_ms": 159340,
   "end_ms": 163019,
   "text": "ああ 記憶消去の魔法だな"
  },
  {
   "start_ms": 163140,
   "end_ms": 165340,
   "text": "耐え難いことがあると 使うんだ"
  },
  {
   "start_ms": 166180,
   "end_ms": 168440,
   "text": "セガの剣って そんなに?"
  },
  {
   "start_ms": 168560,
   "end_ms": 171140,
   "text": "異世界は つらいことが 多くてな"
  },
  {
   "start_ms": 171260,
   "end_ms": 172640,
   "text": "ああ 見るか"
  },
  {
   "start_ms": 172760,
   "end_ms": 174359,
   "text": "ん… うん"
  },
  {
   "start_ms": 176660,
   "end_ms": 177660,
   "text": "うん"
  },
  {
   "start_ms": 178380,
   "end_ms": 179460,
   "text": "ああ!"
  }
 ],
