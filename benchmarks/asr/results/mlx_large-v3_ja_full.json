   "start_ms": 80000,
   "end_ms": 85480,
   "text": "あ はい あのですね"
  },
  {
   "start_ms": 85480,
   "end_ms": 88020,
   "text": "日本語"
  },
  {
   "start_ms": 88020,
   "end_ms": 92020,
   "text": "ああ すまんすまん"
  },
  {
   "start_ms": 92020,
   "end_ms": 94800,
   "text": "異世界 グランバハマルに17年いたが"
  },
  {
   "start_ms": 94800,
   "end_ms": 97020,
   "text": "ようやく帰ってきたぞ だ"
  },
  {
   "start_ms": 97020,
   "end_ms": 103120,
   "text": "ケンオンでーす"
  },
  {
   "start_ms": 103120,
   "end_ms": 106000,
   "text": "ザルベ マディーラ コルストナム コルストナム"
  },
  {
   "start_ms": 106000,
   "end_ms": 108120,
   "text": "あははは そうですね"
  },
  {
   "start_ms": 108120,
   "end_ms": 114860,
   "text": "デルストバ トナ ラベルトガル"
  },
  {
   "start_ms": 114860,
   "end_ms": 118300,
   "text": "はい じゃあまた時間になったら来ますね"
  },
  {
   "start_ms": 118300,
   "end_ms": 128560,
   "text": "姉ちゃんの子供のタカフミか"
  },
  {
   "start_ms": 128560,
   "end_ms": 130800,
   "text": "大きくなったな"
  },
  {
   "start_ms": 130800,
   "end_ms": 133140,
   "text": "他のみんなは"
  },
  {
   "start_ms": 136320,
   "end_ms": 137960,
   "text": "渾水状態のおじさんの"
  },
  {
   "start_ms": 137960,
   "end_ms": 138980,
   "text": "処遇をめぐって"
  },
  {
   "start_ms": 138980,
   "end_ms": 142080,
   "text": "言っちゃいけないことをボロクスを言い合った挙句"
  },
  {
   "start_ms": 142080,
   "end_ms": 143660,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 143660,
   "end_ms": 146080,
   "text": "うちの母さんも"
  },
  {
   "start_ms": 146080,
   "end_ms": 147980,
   "text": "正直会いたくないって"
  },
  {
   "start_ms": 152660,
   "end_ms": 154260,
   "text": "イキュラス キオラ"
  },
  {
   "start_ms": 154260,
   "end_ms": 156080,
   "text": "ふぅ"
  },
  {
   "start_ms": 156080,
   "end_ms": 158460,
   "text": "さて"
  },
  {
   "start_ms": 158460,
   "end_ms": 161940,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 161940,
   "end_ms": 164600,
   "text": "え? いや いいです"
  },
  {
   "start_ms": 164600,
   "end_ms": 166980,
   "text": "ワーグレントセルド"
  },
  {
   "start_ms": 166980,
   "end_ms": 167940,
   "text": "ワーグレントセルド"
  },
  {
   "start_ms": 167940,
   "end_ms": 170880,
   "text": "あれ"
  },
  {
   "start_ms": 170880,
   "end_ms": 173480,
   "text": "ワーグレントマグナ"
  },
  {
   "start_ms": 173480,
   "end_ms": 178359,
   "text": "ワーグレントラルド"
  },
  {
   "start_ms": 178359,
   "end_ms": 180640,
   "text": "本当にすごいな"
  },
  {
   "start_ms": 180640,
   "end_ms": 182340,
   "text": "ワーグレントカッド"
  },
  {
   "start_ms": 182340,
   "end_ms": 183920,
   "text": "ワーグレントパッド"
  },
  {
   "start_ms": 183920,
   "end_ms": 184840,
   "text": "あのさ"
  },
  {
   "start_ms": 184840,
   "end_ms": 187900,
   "text": "不景気でうちも厳しくてさ"
  },
  {
   "start_ms": 187900,
   "end_ms": 189060,
   "text": "ワーグレントスラドセルド"
  },
  {
   "start_ms": 189060,
   "end_ms": 191079,
   "text": "俺もいろいろあってバイトしてるし"
  },
  {
   "start_ms": 191079,
   "end_ms": 194640,
   "text": "自立支援とかあれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 194640,
   "end_ms": 195620,
   "text": "課税を運べ"
  },
  {
   "start_ms": 197940,
   "end_ms": 206840,
   "text": "マジかよ"
  },
  {
   "start_ms": 206840,
   "end_ms": 208400,
   "text": "課税を戻せ"
  },
  {
