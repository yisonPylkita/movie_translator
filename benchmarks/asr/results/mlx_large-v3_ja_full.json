  {
   "start_ms": 230720,
   "end_ms": 235600,
   "text": "というか なんか結構エグいことを言おうとしてなかった?"
  },
  {
   "start_ms": 236160,
   "end_ms": 237020,
   "text": "言ってないよ"
  },
  {
   "start_ms": 237020,
   "end_ms": 238260,
   "text": "本当?"
  },
  {
   "start_ms": 238580,
   "end_ms": 239640,
   "text": "それよりさっきの何?"
  },
  {
   "start_ms": 241120,
   "end_ms": 243660,
   "text": "魔法だよ 火を"
  },
  {
   "start_ms": 243660,
   "end_ms": 247579,
   "text": "すごい!それどうやって出してるの?"
  },
  {
   "start_ms": 247780,
   "end_ms": 250520,
   "text": "そんなことより ゲームハードセンスはどうなった?"
  },
  {
   "start_ms": 251000,
   "end_ms": 251440,
   "text": "セガは?"
  },
  {
   "start_ms": 251800,
   "end_ms": 253340,
   "text": "え?セガ?"
  },
  {
   "start_ms": 253960,
   "end_ms": 255060,
   "text": "い…今?"
  },
  {
   "start_ms": 256000,
   "end_ms": 260019,
   "text": "国内だとソニーと任天堂が二強って感じかな"
  },
  {
   "start_ms": 260019,
   "end_ms": 261680,
   "text": "は?セガは?"
  },
  {
   "start_ms": 262460,
   "end_ms": 263760,
   "text": "ねえ それ今聞くこと"
  },
  {
   "start_ms": 263760,
   "end_ms": 264359,
   "text": "セガは?"
  },
  {
   "start_ms": 265640,
   "end_ms": 269140,
   "text": "いや とっくに撤退したけど"
  },
  {
   "start_ms": 269140,
   "end_ms": 274120,
   "text": "イキュラスキオラ"
  },
  {
   "start_ms": 274120,
   "end_ms": 278780,
   "text": "ねえ そのイキュラスキオラって何?"
  },
  {
   "start_ms": 279460,
   "end_ms": 282840,
   "text": "ああ 記憶消去の魔法だな"
  },
  {
   "start_ms": 282840,
   "end_ms": 285440,
   "text": "耐えがたいことがあると使うんだ"
  },
  {
   "start_ms": 285440,
   "end_ms": 287900,
   "text": "セガの剣ってそんなに?"
  },
  {
   "start_ms": 288400,
   "end_ms": 289900,
   "text": "異世界は辛いことがある"
  },
  {
   "start_ms": 290020,
   "end_ms": 290859,
   "text": "まあ多くてな"
  },
  {
   "start_ms": 290859,
   "end_ms": 292640,
   "text": "見るか"
  },
  {
   "start_ms": 292640,
   "end_ms": 293780,
   "text": "うん"
  },
  {
   "start_ms": 293780,
   "end_ms": 307760,
   "text": "読んだ記憶 消してください"
  },
  {
   "start_ms": 307760,
   "end_ms": 310000,
   "text": "そうだろう"
  },
  {
   "start_ms": 310000,
   "end_ms": 313840,
   "text": "記憶の精霊よ 忘却の彼方を消したら"
  },
  {
   "start_ms": 313840,
   "end_ms": 316419,
   "text": "セガの剣はこのレベルだったのか"
  },
  {
   "start_ms": 320020,
   "end_ms": 321020,
   "text": "一週間後"
  },
  {
   "start_ms": 321020,
   "end_ms": 326940,
   "text": "単位したおじさんの力を金に変えて食っていこうと心に決めた"
  },
  {
   "start_ms": 326940,
   "end_ms": 330740,
   "text": "とりあえずYouTubeで動画を公開して"
  },
  {
   "start_ms": 330740,
   "end_ms": 333219,
   "text": "6万ほど広告収入を得た"
  },
  {
   "start_ms": 333219,
   "end_ms": 339859,
   "text": "おやすみなさい"
  },
  {
