  {
   "start_ms": 645,
   "end_ms": 2446,
   "text": "We knew the world would not be the same."
  },
  {
   "start_ms": 5827,
   "end_ms": 7708,
   "text": "Few people laughed."
  },
  {
   "start_ms": 9949,
   "end_ms": 10989,
   "text": "Few people cried."
  },
  {
   "start_ms": 12170,
   "end_ms": 13490,
   "text": "Most people were silent."
  },
  {
   "start_ms": 17091,
   "end_ms": 21993,
   "text": "I remembered the line from the Hindu scripture, the Bhagavad Gita."
  },
  {
   "start_ms": 25655,
   "end_ms": 26135,
   "text": "Vishnu."
  },
  {
   "start_ms": 28832,
   "end_ms": 34473,
   "text": "is trying to persuade the prince that he should do his duty."
  },
  {
   "start_ms": 35574,
   "end_ms": 47157,
   "text": "And to impress him, takes on his multi-armed form and says, now I am become death, the destroyer of worlds."
  },
  {
   "start_ms": 50417,
   "end_ms": 52658,
   "text": "I suppose we all thought that one way or another."
  }
 ],
