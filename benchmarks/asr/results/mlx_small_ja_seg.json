   "text": "はぁ"
  },
  {
   "start_ms": 112000,
   "end_ms": 114000,
   "text": "というか"
  },
  {
   "start_ms": 114000,
   "end_ms": 116000,
   "text": "えぐいことを言おうとしてなかった"
  },
  {
   "start_ms": 116000,
   "end_ms": 118000,
   "text": "言ってないよ"
  },
  {
   "start_ms": 118000,
   "end_ms": 120000,
   "text": "本当?"
  },
  {
   "start_ms": 120000,
   "end_ms": 122000,
   "text": "はぁ"
  },
  {
   "start_ms": 122000,
   "end_ms": 124000,
   "text": "魔法だよ"
  },
  {
   "start_ms": 124000,
   "end_ms": 126000,
   "text": "火を"
  },
  {
   "start_ms": 126000,
   "end_ms": 128000,
   "text": "すごい!それどうやって出してるの?"
  },
  {
   "start_ms": 128000,
   "end_ms": 130000,
   "text": "そんなことよりゲームハードセンスはどうなった?"
  },
  {
   "start_ms": 130000,
   "end_ms": 132000,
   "text": "せがは"
  },
  {
   "start_ms": 132000,
   "end_ms": 134000,
   "text": "え?"
  },
  {
   "start_ms": 134000,
   "end_ms": 136000,
   "text": "せが?い、今"
  },
  {
   "start_ms": 136000,
   "end_ms": 138000,
   "text": "国内だと"
  },
  {
   "start_ms": 138000,
   "end_ms": 140000,
   "text": "ソニーとニンテンドーが二強って感じかな?"
  },
  {
   "start_ms": 140000,
   "end_ms": 142000,
   "text": "はぁ"
  },
  {
   "start_ms": 142000,
   "end_ms": 144000,
   "text": "ねえそれ今"
  },
  {
   "start_ms": 144000,
   "end_ms": 146000,
   "text": "せがは?"
  },
  {
   "start_ms": 146000,
   "end_ms": 148000,
   "text": "いや"
  },
  {
   "start_ms": 148000,
   "end_ms": 150000,
   "text": "特に撤退したけど"
  },
  {
   "start_ms": 150000,
   "end_ms": 152000,
   "text": "イキュラスキュラ"
  },
  {
   "start_ms": 152000,
   "end_ms": 154000,
   "text": "イキュラスキュラ"
  },
  {
   "start_ms": 154000,
   "end_ms": 156000,
   "text": "イキュラスキュラって何?"
  },
  {
   "start_ms": 156000,
   "end_ms": 158000,
   "text": "おぉ"
  },
  {
   "start_ms": 158000,
   "end_ms": 160000,
   "text": "記憶消去の魔法だな"
  },
  {
   "start_ms": 160000,
   "end_ms": 162000,
   "text": "耐え難いことがあると使うんだ"
  },
  {
   "start_ms": 162000,
   "end_ms": 164000,
   "text": "せがの剣ってそんなに?"
  },
  {
   "start_ms": 164000,
   "end_ms": 166000,
   "text": "異世界は"
  },
  {
   "start_ms": 166000,
   "end_ms": 168000,
   "text": "辛いことが多くてなぁ"
  },
  {
   "start_ms": 168000,
   "end_ms": 170000,
   "text": "見るか"
  },
  {
   "start_ms": 170000,
   "end_ms": 172000,
