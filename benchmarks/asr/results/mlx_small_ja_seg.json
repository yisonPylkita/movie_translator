  {
   "start_ms": 34000,
   "end_ms": 36000,
   "text": "うーん"
  },
  {
   "start_ms": 36000,
   "end_ms": 38000,
   "text": "さて"
  },
  {
   "start_ms": 38000,
   "end_ms": 40000,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 40000,
   "end_ms": 42000,
   "text": "え?"
  },
  {
   "start_ms": 42000,
   "end_ms": 44000,
   "text": "いや、いいです"
  },
  {
   "start_ms": 44000,
   "end_ms": 46000,
   "text": "ワーグレントセルド"
  },
  {
   "start_ms": 46000,
   "end_ms": 48000,
   "text": "あれ"
  },
  {
   "start_ms": 48000,
   "end_ms": 50000,
   "text": "ワーグレントマグナ"
  },
  {
   "start_ms": 50000,
   "end_ms": 52000,
   "text": "ワーグレントラルド"
  },
  {
   "start_ms": 52000,
   "end_ms": 54000,
   "text": "本当に?"
  },
  {
   "start_ms": 54000,
   "end_ms": 56000,
   "text": "ワーグレントラルド"
  },
  {
   "start_ms": 56000,
   "end_ms": 58000,
   "text": "本当に?"
  },
  {
   "start_ms": 58000,
   "end_ms": 60000,
   "text": "すげぇな"
  },
  {
   "start_ms": 60000,
   "end_ms": 62000,
   "text": "ワーグレントガッド"
  },
  {
   "start_ms": 62000,
   "end_ms": 64000,
   "text": "ワーグレントパッド"
  },
  {
   "start_ms": 64000,
   "end_ms": 66000,
   "text": "あのさ、不景気で"
  },
  {
   "start_ms": 66000,
   "end_ms": 68000,
   "text": "うちも厳しくてさ"
  },
  {
   "start_ms": 68000,
   "end_ms": 70000,
   "text": "これもいろいろあってバイトしてるし"
  },
  {
   "start_ms": 70000,
   "end_ms": 72000,
   "text": "自立支援とか"
  },
  {
   "start_ms": 72000,
   "end_ms": 74000,
   "text": "あれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 74000,
   "end_ms": 76000,
   "text": "風を運べ"
  },
  {
   "start_ms": 82000,
   "end_ms": 84000,
   "text": "はぁ"
  },
  {
   "start_ms": 84000,
   "end_ms": 86000,
   "text": "はぁ"
  },
  {
   "start_ms": 86000,
   "end_ms": 88000,
   "text": "マジかよ"
  },
  {
   "start_ms": 88000,
   "end_ms": 90000,
   "text": "風を戻せ"
  },
  {
   "start_ms": 90000,
   "end_ms": 92000,
   "text": "こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 92000,
   "end_ms": 94000,
   "text": "はぁ"
  },
  {
   "start_ms": 94000,
   "end_ms": 96000,
