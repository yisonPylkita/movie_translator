 "segments": [
  {
   "start_ms": 0,
   "end_ms": 8500,
   "text": "姉ちゃんの子供の高文か"
  },
  {
   "start_ms": 8500,
   "end_ms": 10820,
   "text": "大きくなったな"
  },
  {
   "start_ms": 10820,
   "end_ms": 13180,
   "text": "他のみんなは"
  },
  {
   "start_ms": 16360,
   "end_ms": 18940,
   "text": "渾水状態のおじさんの処遇をめぐって"
  },
  {
   "start_ms": 18940,
   "end_ms": 22100,
   "text": "言っちゃいけないことをボロクソ言い合った挙句"
  },
  {
   "start_ms": 22100,
   "end_ms": 23620,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 23620,
   "end_ms": 28020,
   "text": "うちの母さんも正直会いたくないって"
  },
  {
   "start_ms": 28020,
   "end_ms": 34280,
   "text": "イキュラス・キュオラ"
  },
  {
   "start_ms": 34280,
   "end_ms": 36100,
   "text": "ふぅ"
  },
  {
   "start_ms": 36100,
   "end_ms": 38500,
   "text": "さて"
  },
  {
   "start_ms": 38500,
   "end_ms": 41920,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 41920,
   "end_ms": 44320,
   "text": "え?いや、いいです"
  },
  {
   "start_ms": 45379,
   "end_ms": 46940,
   "text": "ワーグレント・セルド"
  },
  {
   "start_ms": 46940,
   "end_ms": 50860,
   "text": "あれ?"
  },
  {
   "start_ms": 52080,
   "end_ms": 53480,
   "text": "ワーグレント・マグナ"
  },
  {
   "start_ms": 53480,
   "end_ms": 58000,
   "text": "ワーグレント・ラグナ"
  },
  {
   "start_ms": 58020,
   "end_ms": 61260,
   "text": "ワーグレント・ネルド"
  },
  {
   "start_ms": 61260,
   "end_ms": 62340,
   "text": "ワーグレント・ガッド"
  },
  {
   "start_ms": 62340,
   "end_ms": 63920,
   "text": "ワーグレント・パッド"
  },
  {
   "start_ms": 63920,
   "end_ms": 67900,
   "text": "あのさ、不景気でうちも厳しくてさ"
  },
  {
   "start_ms": 67900,
   "end_ms": 71040,
   "text": "俺もいろいろあってバイトしてるし"
  },
  {
   "start_ms": 71040,
   "end_ms": 74860,
   "text": "自立支援とかあれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 74860,
   "end_ms": 75640,
   "text": "課税を運べ"
  },
  {
   "start_ms": 85640,
   "end_ms": 86800,
   "text": "マジかよ!"
  },
  {
   "start_ms": 87340,
   "end_ms": 88000,
   "text": "課税を持ってきてるんだよ"
  },
  {
   "start_ms": 88020,
   "end_ms": 88520,
   "text": "戻せ"
  },
  {
   "start_ms": 88520,
   "end_ms": 93399,
   "text": "こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 93399,
   "end_ms": 96380,
   "text": "はぁ"
  },
  {
   "start_ms": 96380,
   "end_ms": 109380,
   "text": "本物だ"
  },
  {
   "start_ms": 109380,
   "end_ms": 112440,
   "text": "というか"
  },
  {
   "start_ms": 112440,
   "end_ms": 115600,
   "text": "なんか結構エグいこと言おうとしてなかった?"
  },
  {
   "start_ms": 116179,
   "end_ms": 116720,
   "text": "言ってないよ"
  },
  {
   "start_ms": 116720,
   "end_ms": 117340,
   "text": "本物だよ"
  },
  {
   "start_ms": 117340,
   "end_ms": 118320,
   "text": "本当?"
  },
  {
   "start_ms": 118580,
   "end_ms": 119620,
   "text": "それよりさっきの何?"
  },
  {
   "start_ms": 121040,
   "end_ms": 122460,
   "text": "魔法だよ"
  },
  {
   "start_ms": 122460,
   "end_ms": 123660,
   "text": "火を"
  },
  {
   "start_ms": 123660,
   "end_ms": 125800,
   "text": "うわっすごい!"
  },
  {
   "start_ms": 126280,
   "end_ms": 127580,
   "text": "それどうやって出してるの?"
  },
  {
   "start_ms": 127780,
   "end_ms": 130520,
   "text": "そんなことよりゲームハードセンスはどうなった?"
  },
  {
   "start_ms": 131000,
   "end_ms": 131480,
   "text": "セガは?"
  },
  {
   "start_ms": 131800,
   "end_ms": 133340,
   "text": "え?セガ?"
  },
  {
   "start_ms": 133960,
   "end_ms": 135060,
   "text": "い、今?"
  },
  {
   "start_ms": 136280,
   "end_ms": 140040,
   "text": "国内だとソニーと任天堂が二強って感じかな"
  },
  {
   "start_ms": 140040,
   "end_ms": 141680,
   "text": "は?セガは?"
  },
  {
   "start_ms": 142460,
   "end_ms": 143740,
   "text": "ねえ、それ今聞くこと"
  },
  {
   "start_ms": 143740,
   "end_ms": 144380,
   "text": "セガは?"
  },
  {
   "start_ms": 145700,
   "end_ms": 146100,
   "text": "いや"
  },
  {
   "start_ms": 146100,
   "end_ms": 146660,
   "text": "いや"
  },
  {
   "start_ms": 146660,
   "end_ms": 148960,
   "text": "とっくに撤退したけど"
  },
  {
   "start_ms": 148960,
   "end_ms": 154120,
   "text": "イキュラスキオラ"
  },
  {
   "start_ms": 154120,
   "end_ms": 158780,
   "text": "ねえ、そのイキュラスキオラって何?"
  },
  {
   "start_ms": 159460,
   "end_ms": 162840,
   "text": "ああ、記憶消去の魔法だな"
  },
  {
   "start_ms": 162840,
   "end_ms": 165440,
   "text": "耐え難いことがあると使うんだ"
  },
  {
   "start_ms": 165440,
   "end_ms": 167920,
   "text": "セガの剣ってそんなに?"
  },
  {
   "start_ms": 168660,
   "end_ms": 170900,
   "text": "異世界は辛いことが多くてな"
  },
  {
   "start_ms": 170900,
   "end_ms": 172220,
   "text": "見るか"
  },
  {
   "start_ms": 172220,
   "end_ms": 173740,
   "text": "うん"
  },
  {
   "start_ms": 176660,
   "end_ms": 179980,
   "text": "ああっ"
  }
 ],
