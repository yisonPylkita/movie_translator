 "segments": [
  {
   "start_ms": 0,
   "end_ms": 2480,
   "text": "We knew the world would not be the same."
  },
  {
   "start_ms": 5160,
   "end_ms": 7680,
   "text": "Few people laughed."
  },
  {
   "start_ms": 9320,
   "end_ms": 10940,
   "text": "Few people cried."
  },
  {
   "start_ms": 12120,
   "end_ms": 13460,
   "text": "Most people were silent."
  },
  {
   "start_ms": 16360,
   "end_ms": 21900,
   "text": "I remembered the line from the Hindu scripture, the Bhagavad Gita."
  },
  {
   "start_ms": 21900,
   "end_ms": 34440,
   "text": "The Bhagavad Gita, Vishnu is trying to persuade the prince that he should do his duty."
  },
  {
   "start_ms": 35580,
   "end_ms": 42540,
   "text": "And to impress him, takes on his multi-armed form and says,"
  },
  {
   "start_ms": 43239,
   "end_ms": 47180,
   "text": "Now I am become death, the destroyer of worlds."
  },
  {
   "start_ms": 49800,
   "end_ms": 51599,
   "text": "I suppose we all thought that."
  },
  {
   "start_ms": 51900,
   "end_ms": 52600,
   "text": "One way or another."
  }
 ],
