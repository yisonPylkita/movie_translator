 "segments": [
  {
   "start_ms": 0,
   "end_ms": 8560,
   "text": "姉ちゃんの子供の高文か"
  },
  {
   "start_ms": 8560,
   "end_ms": 11000,
   "text": "大きくなったな"
  },
  {
   "start_ms": 11000,
   "end_ms": 14000,
   "text": "他のみんなは"
  },
  {
   "start_ms": 14000,
   "end_ms": 19000,
   "text": "渾水状態のおじさんの処遇をめぐって"
  },
  {
   "start_ms": 19000,
   "end_ms": 22140,
   "text": "言っちゃいけないことをボロックスを言い合ったあげく"
  },
  {
   "start_ms": 22140,
   "end_ms": 24000,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 24000,
   "end_ms": 28000,
   "text": "うちの母も正直会いたくないって"
  },
  {
   "start_ms": 34300,
   "end_ms": 42000,
   "text": "イキュラスキオラふうにいた証拠を見せよう"
  },
  {
   "start_ms": 42000,
   "end_ms": 44380,
   "text": "いやいいです"
  },
  {
   "start_ms": 44380,
   "end_ms": 47000,
   "text": "ワーグレントセルド"
  },
  {
   "start_ms": 47000,
   "end_ms": 50880,
   "text": "あれ"
  },
  {
   "start_ms": 50880,
   "end_ms": 58400,
   "text": "ワーグレントマグレントラルド"
  },
  {
   "start_ms": 58400,
   "end_ms": 60440,
   "text": "ホーグレントネルド"
  },
  {
   "start_ms": 60440,
   "end_ms": 67880,
   "text": "ワーグレントネルドワーグレントパッドあのさ不景気でうちも厳しくてさ"
  },
  {
   "start_ms": 67880,
   "end_ms": 70940,
   "text": "俺もいろいろあってバイトしてるし"
  },
  {
   "start_ms": 70940,
   "end_ms": 75000,
   "text": "自立支援とかあれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 75000,
   "end_ms": 86820,
   "text": "課税を運べマジかよ"
  },
  {
   "start_ms": 86820,
   "end_ms": 88740,
   "text": "課税を戻せ"
  },
  {
   "start_ms": 88740,
   "end_ms": 93000,
   "text": "こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 93000,
   "end_ms": 115600,
   "text": "はあというかなんか結構エグいことを言おうとしてなかった"
  },
  {
   "start_ms": 115600,
   "end_ms": 117000,
   "text": "言ってないよ"
  },
  {
   "start_ms": 117000,
   "end_ms": 118440,
   "text": "本当?"
  },
  {
   "start_ms": 118440,
   "end_ms": 119660,
   "text": "それよりさっきの何?"
  },
  {
   "start_ms": 119660,
   "end_ms": 144000,
   "text": "魔法だよ火をすごいそれどうやって出してるのそんなことよりゲームハードセンスはどうなったセガはえっセガー?今?国内だとソニーとニンテンドーが二挙って感じかなは?セガは?それ今聞くこと"
  },
  {
   "start_ms": 144000,
   "end_ms": 146140,
   "text": "いや"
  },
  {
   "start_ms": 146140,
   "end_ms": 149040,
   "text": "とっくに撤退したけど"
  },
  {
   "start_ms": 149040,
   "end_ms": 154180,
   "text": "イキュラスキオラ"
  },
  {
   "start_ms": 154180,
   "end_ms": 156920,
   "text": "ねえ"
  },
  {
   "start_ms": 156920,
   "end_ms": 158740,
   "text": "そのイキュラスキオラって何"
  },
  {
   "start_ms": 158740,
   "end_ms": 159880,
   "text": "ああ"
  },
  {
   "start_ms": 159880,
   "end_ms": 163000,
   "text": "記憶消去の魔法だな"
  },
  {
   "start_ms": 163000,
   "end_ms": 165400,
   "text": "耐えがたいことがあると使うんだ"
  },
  {
   "start_ms": 165400,
   "end_ms": 168000,
   "text": "セガの剣ってそんなに"
  },
  {
   "start_ms": 168000,
   "end_ms": 171000,
   "text": "異世界はつらいことが多くてな"
  },
  {
   "start_ms": 171000,
   "end_ms": 173000,
   "text": "見るか"
  },
  {
   "start_ms": 173000,
   "end_ms": 176000,
   "text": "うん"
  }
 ],
