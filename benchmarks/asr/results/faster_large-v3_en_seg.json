  {
   "start_ms": 64580,
   "end_ms": 65500,
   "text": "Wargrant Rald."
  },
  {
   "start_ms": 65500,
   "end_ms": 66000,
   "text": "Hey, Uncle..."
  },
  {
   "start_ms": 66000,
   "end_ms": 68100,
   "text": "Money has been a little tight lately."
  },
  {
   "start_ms": 68100,
   "end_ms": 68960,
   "text": "Wargrant Slagger!"
  },
  {
   "start_ms": 68960,
