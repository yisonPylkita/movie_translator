  },
  {
   "start_ms": 340960,
   "end_ms": 342960,
   "text": "ここで"
  },
  {
   "start_ms": 342960,
   "end_ms": 346960,
   "text": "absorbed"
  },
  {
   "start_ms": 346960,
   "end_ms": 348960,
   "text": "さぁ"
  },
  {
   "start_ms": 348960,
   "end_ms": 350960,
   "text": "運動"
  },
  {
   "start_ms": 350960,
   "end_ms": 354960,
   "text": "雪リプス"
  },
  {
   "start_ms": 354960,
   "end_ms": 356960,
   "text": "暴れ"
  },
  {
   "start_ms": 356960,
   "end_ms": 358960,
   "text": "伸び"
  },
  {
   "start_ms": 358960,
   "end_ms": 361280,
   "text": "する言葉で"
  },
  {
   "start_ms": 361280,
   "end_ms": 363599,
   "text": "Don't end this one change"
  },
  {
   "start_ms": 363599,
   "end_ms": 366280,
   "text": "どうしたって変えられない"
  },
  {
   "start_ms": 366280,
   "end_ms": 369760,
   "text": "目的を忘れないでいて"
  },
  {
   "start_ms": 369760,
   "end_ms": 373320,
   "text": "誰か決めたんだ"
  },
  {
   "start_ms": 373320,
   "end_ms": 377760,
   "text": "そんなにきっかけらしくないよ"
  },
  {
   "start_ms": 377760,
   "end_ms": 380960,
   "text": "やりたいことすらぬ価値から"
  },
  {
   "start_ms": 380960,
   "end_ms": 383280,
   "text": "それこそが強さだって"
  },
  {
   "start_ms": 383280,
   "end_ms": 387080,
   "text": "分かっているから"
  },
  {
   "start_ms": 388000,
   "end_ms": 389840,
   "text": "I believe in what I've done"
  },
  {
   "start_ms": 389840,
   "end_ms": 392039,
   "text": "No reason to give up again"
  },
  {
   "start_ms": 392039,
   "end_ms": 394240,
   "text": "歩で来た日々を"
  },
  {
   "start_ms": 394240,
   "end_ms": 396680,
   "text": "懐かしぶ意味を"
  },
  {
   "start_ms": 396680,
   "end_ms": 398560,
   "text": "Is it losing memories?"
  },
  {
   "start_ms": 398560,
   "end_ms": 400760,
   "text": "I'm struggling now to overcome"
  },
  {
   "start_ms": 400760,
   "end_ms": 404000,
   "text": "諦めることはない"
  },
  {
   "start_ms": 404000,
   "end_ms": 405400,
   "text": "最後まで"
  },
  {
   "start_ms": 405400,
   "end_ms": 407280,
   "text": "Get down, let's get down"
  },
  {
   "start_ms": 407280,
   "end_ms": 411640,
   "text": "心の光を"
  },
  {
   "start_ms": 411640,
   "end_ms": 414240,
   "text": "覚えてるうちに"
  },
  {
   "start_ms": 414240,
   "end_ms": 416840,
   "text": "Try my soul, my soul"
  },
  {
   "start_ms": 416840,
   "end_ms": 419000,
   "text": "Don't be afraid"
  },
  {
   "start_ms": 419000,
   "end_ms": 421160,
   "text": "Save yourself"
  },
  {
   "start_ms": 421160,
   "end_ms": 423400,
   "text": "Don't tell me again"
  },
  {
   "start_ms": 440880,
   "end_ms": 443120,
   "text": "済まわせてもらってなんだが"
  },
  {
   "start_ms": 443120,
   "end_ms": 444200,
   "text": "広くないか?"
  },
  {
   "start_ms": 444200,
   "end_ms": 445400,
   "text": "この物件"
