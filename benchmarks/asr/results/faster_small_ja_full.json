  {
   "start_ms": 445400,
   "end_ms": 447040,
   "text": "ああ"
  },
  {
   "start_ms": 447040,
   "end_ms": 449600,
   "text": "もともとルームシェアしてたんだけど"
  },
  {
   "start_ms": 449600,
   "end_ms": 451400,
   "text": "同居人といろいろあって"
  },
  {
   "start_ms": 451400,
   "end_ms": 452440,
   "text": "同居?"
  },
  {
   "start_ms": 452440,
   "end_ms": 453440,
   "text": "同性?"
  },
  {
   "start_ms": 453440,
   "end_ms": 454880,
   "text": "ああ、いや"
  },
  {
   "start_ms": 454880,
   "end_ms": 456040,
   "text": "すっげえ"
  },
  {
   "start_ms": 456040,
   "end_ms": 458160,
   "text": "違うよ!ルームシェアだよ!"
  },
  {
   "start_ms": 458160,
   "end_ms": 460000,
   "text": "知ってるでしょ?"
  },
  {
   "start_ms": 460000,
   "end_ms": 460880,
   "text": "知らん"
  },
  {
   "start_ms": 460880,
   "end_ms": 462560,
   "text": "えっ?"
  },
  {
   "start_ms": 462560,
   "end_ms": 465200,
   "text": "17年前、なかったんだ"
  },
  {
   "start_ms": 465200,
   "end_ms": 468520,
   "text": "おお、そんなにすぐ調べられるのか"
  },
  {
   "start_ms": 468520,
   "end_ms": 470760,
   "text": "文号を見にも進化したな"
  },
  {
   "start_ms": 470760,
   "end_ms": 472080,
   "text": "うん"
  },
  {
   "start_ms": 472080,
   "end_ms": 473080,
   "text": "は?"
  },
  {
   "start_ms": 475400,
   "end_ms": 477640,
   "text": "高踏みがな"
  },
  {
   "start_ms": 477640,
   "end_ms": 480880,
   "text": "仲間を募って共同生活か"
  },
  {
   "start_ms": 486240,
   "end_ms": 489440,
   "text": "あのさ、おじさんの異世界での仲間って"
  },
  {
   "start_ms": 489440,
   "end_ms": 491000,
   "text": "どんな人たちだったの?"
  },
  {
   "start_ms": 491000,
   "end_ms": 492280,
   "text": "ああ"
  },
  {
   "start_ms": 492280,
   "end_ms": 494360,
   "text": "俺は基本的に17年間"
  },
  {
   "start_ms": 494360,
   "end_ms": 496120,
   "text": "一人プレイだったから"
  },
  {
   "start_ms": 503640,
   "end_ms": 504640,
   "text": "へー"
  },
  {
   "start_ms": 506240,
   "end_ms": 509400,
   "text": "いせかいじんは用紙が整っていてな"
  },
  {
   "start_ms": 509400,
   "end_ms": 511760,
   "text": "美男美女ゾロイなんだ"
  },
  {
   "start_ms": 511760,
   "end_ms": 514040,
   "text": "えっ?いいじゃない?"
  },
  {
   "start_ms": 514040,
   "end_ms": 516160,
   "text": "見にくかったんだろうな"
  },
  {
   "start_ms": 516160,
   "end_ms": 517160,
   "text": "えっ?"
  },
  {
   "start_ms": 525640,
   "end_ms": 528640,
   "text": "多くの足として絡めかけた"
  },
  {
   "start_ms": 528640,
   "end_ms": 530800,
   "text": "おじさん、おじさん、おじさん"
  },
  {
   "start_ms": 530800,
   "end_ms": 532800,
   "text": "おじさん、おじさん"
  },
  {
   "start_ms": 532800,
   "end_ms": 534800,
   "text": "おじさん、おじさん"
  },
  {
   "start_ms": 535120,
   "end_ms": 537120,
   "text": "おじさん、ちょっと待って"
  },
  {
   "start_ms": 537120,
   "end_ms": 538000,
   "text": "それでな"
  },
  {
   "start_ms": 538000,
   "end_ms": 539000,
   "text": "お前!"
  },
  {
   "start_ms": 540199,
   "end_ms": 543319,
   "text": "サラーライしながら聞く話じゃない"
  },
  {
   "start_ms": 543319,
   "end_ms": 546079,
   "text": "まあ、番地そんな感じだったんだが"
  },
  {
   "start_ms": 546079,
   "end_ms": 548240,
   "text": "特に攻撃的な奴がいてな"
  },
  {
   "start_ms": 548240,
   "end_ms": 549560,
   "text": "ちょっと待ってては"
  },
  {
   "start_ms": 549560,
   "end_ms": 551640,
   "text": "毎日まとわりついてきて"
  },
  {
   "start_ms": 551640,
   "end_ms": 553160,
   "text": "嫌がらせっていうか"
  },
  {
   "start_ms": 553160,
   "end_ms": 555400,
   "text": "俺が何やっても人格否定とか"
  },
  {
   "start_ms": 555400,
   "end_ms": 557439,
   "text": "罵倒とかしてくるんだよ"
  },
  {
   "start_ms": 560000,
   "end_ms": 561719,
   "text": "ひどいな"
  },
  {
   "start_ms": 561719,
   "end_ms": 563640,
   "text": "異世界ファンタジーって言っても"
  },
  {
   "start_ms": 563640,
   "end_ms": 565360,
   "text": "結局そんなもんか"
  },
  {
   "start_ms": 565360,
   "end_ms": 566880,
   "text": "初めて会った時も"
  },
  {
   "start_ms": 566880,
   "end_ms": 568360,
   "text": "魔物から助けたのに"
  },
  {
   "start_ms": 568360,
   "end_ms": 569960,
   "text": "例もなかった"
  },
  {
   "start_ms": 569960,
   "end_ms": 571600,
   "text": "最低だね、そいつ"
  },
  {
   "start_ms": 571600,
   "end_ms": 572800,
   "text": "だろう?"
  },
  {
   "start_ms": 572800,
   "end_ms": 573840,
   "text": "確か"
  },
  {
   "start_ms": 573840,
   "end_ms": 576000,
   "text": "誰も助けてなんか頼んでないわ"
  },
  {
   "start_ms": 576000,
   "end_ms": 577080,
   "text": "触らないで"
  },
  {
   "start_ms": 577080,
   "end_ms": 577880,
   "text": "とか"
  },
  {
   "start_ms": 577880,
   "end_ms": 580040,
   "text": "あんたのために助けたんじゃないわ"
  },
  {
   "start_ms": 580040,
   "end_ms": 581240,
   "text": "勘違いしないで"
  },
  {
   "start_ms": 581240,
   "end_ms": 581840,
   "text": "とか"
  },
  {
   "start_ms": 581840,
   "end_ms": 583880,
   "text": "あんたみたいなおけがうと一緒で"
  },
  {
   "start_ms": 583880,
   "end_ms": 585040,
   "text": "測らずにいられるの"
  },
  {
   "start_ms": 585040,
   "end_ms": 586480,
   "text": "あたしぐらいなものね"
  },
  {
   "start_ms": 586480,
   "end_ms": 588240,
   "text": "とか"
  },
  {
   "start_ms": 588240,
   "end_ms": 591439,
   "text": "とにかく嫌がらせの言葉がひどいんだ"
  },
  {
   "start_ms": 591440,
   "end_ms": 594040,
   "text": "適当な街で巻いて逃げたよ"
  },
  {
   "start_ms": 599640,
   "end_ms": 602120,
   "text": "触らないで"
  },
  {
   "start_ms": 602120,
   "end_ms": 605160,
   "text": "勘違いしないで"
  },
  {
   "start_ms": 605160,
   "end_ms": 607040,
   "text": "あんたみたいなおけがうと一緒で"
  },
  {
   "start_ms": 607040,
   "end_ms": 608920,
   "text": "測らずにいられるのは"
  },
  {
   "start_ms": 608920,
   "end_ms": 610920,
   "text": "あたしぐらいなものね"
  },
  {
   "start_ms": 616880,
   "end_ms": 618800,
   "text": "ツンデレ概念の一般化は"
  },
  {
   "start_ms": 618800,
   "end_ms": 620960,
   "text": "2004年ごろ"
  },
  {
   "start_ms": 620960,
   "end_ms": 624240,
   "text": "おじさんが旅だった4年後である"
  },
  {
   "start_ms": 624240,
   "end_ms": 626160,
   "text": "その後、その子は?"
  },
  {
   "start_ms": 626160,
   "end_ms": 626960,
   "text": "ん?"
  },
  {
   "start_ms": 626960,
   "end_ms": 629440,
   "text": "さあ"
  },
  {
   "start_ms": 629440,
   "end_ms": 632000,
   "text": "まあ、そう言ったわけで"
  },
  {
   "start_ms": 632000,
   "end_ms": 636840,
   "text": "異世界でもうまくいかなかったのが俺だ"
  },
  {
   "start_ms": 636840,
   "end_ms": 637920,
   "text": "だが"
  },
  {
   "start_ms": 637920,
   "end_ms": 639480,
   "text": "帰ってきてみれば"
  },
  {
   "start_ms": 639480,
   "end_ms": 640360,
   "text": "ネット!"
  },
  {
   "start_ms": 640360,
   "end_ms": 641520,
   "text": "光回線?"
  },
  {
   "start_ms": 641520,
   "end_ms": 642520,
   "text": "ウィフィー?"
  },
  {
   "start_ms": 642520,
   "end_ms": 644160,
   "text": "かわいつはいいなぁ"
  },
  {
   "start_ms": 644160,
   "end_ms": 648880,
   "text": "俺でも動画で世界中の人とつながれる"
  },
  {
   "start_ms": 648880,
   "end_ms": 650240,
   "text": "は?"
  },
  {
   "start_ms": 651960,
   "end_ms": 654560,
   "text": "異世界から帰ってきたおじさんは"
  },
  {
   "start_ms": 654560,
   "end_ms": 657960,
   "text": "ネットという新たな異世界へと踏み出した"
  },
  {
   "start_ms": 657960,
   "end_ms": 658960,
   "text": "は?"
  },
  {
   "start_ms": 658960,
   "end_ms": 659960,
   "text": "顔まっかって"
  },
  {
   "start_ms": 659960,
   "end_ms": 660960,
   "text": "なんでこいつにわかるの?"
  },
  {
   "start_ms": 660960,
   "end_ms": 661960,
   "text": "こ、このちっちゃいカメラ?"
  },
  {
   "start_ms": 661960,
   "end_ms": 663960,
   "text": "タンナル上トークだよ"
  },
  {
   "start_ms": 663960,
   "end_ms": 666960,
   "text": "俺、コメントの自作自演なんてしてないぞ"
  },
  {
   "start_ms": 666960,
   "end_ms": 668960,
   "text": "低級分、低級分だから"
  },
  {
   "start_ms": 669960,
   "end_ms": 670960,
   "text": "おい!"
  },
  {
   "start_ms": 670960,
   "end_ms": 672960,
   "text": "なんでダブリーをたくさんつけるんだ!"
  },
  {
   "start_ms": 673960,
   "end_ms": 676960,
   "text": "あおり体制はまだない"
  },
  {
   "start_ms": 677960,
   "end_ms": 679960,
   "text": "この携帯が欲しい"
  },
  {
   "start_ms": 679960,
   "end_ms": 680960,
   "text": "ひらくんじゃなくて"
  },
  {
   "start_ms": 680960,
   "end_ms": 681960,
   "text": "回るんだぞ"
  },
  {
   "start_ms": 681960,
   "end_ms": 682960,
   "text": "おじさん"
  },
  {
   "start_ms": 682960,
   "end_ms": 683960,
   "text": "それ通じ"
  },
  {
   "start_ms": 683960,
   "end_ms": 684960,
   "text": "ん?"
  },
  {
   "start_ms": 684960,
   "end_ms": 686960,
   "text": "このネットオクションってので"
  },
  {
   "start_ms": 686960,
   "end_ms": 687960,
   "text": "買えるんだよな"
  },
  {
   "start_ms": 687960,
   "end_ms": 689960,
   "text": "多分電波の企画が古いから"
  },
  {
   "start_ms": 689960,
   "end_ms": 691960,
   "text": "通話とかできないと"
  },
  {
   "start_ms": 691960,
   "end_ms": 692960,
   "text": "いいよ"
  },
  {
   "start_ms": 692960,
   "end_ms": 693960,
   "text": "通話は"
  },
  {
   "start_ms": 693960,
   "end_ms": 694960,
   "text": "でも"
  },
  {
   "start_ms": 694960,
   "end_ms": 696960,
   "text": "地元の中高の友達とか"
  },
  {
   "start_ms": 697960,
   "end_ms": 698960,
   "text": "高踏み"
  },
  {
   "start_ms": 699960,
   "end_ms": 700960,
   "text": "セガのおじさん"
  },
  {
   "start_ms": 700960,
   "end_ms": 701960,
   "text": "おじさん"
  },
  {
   "start_ms": 701960,
   "end_ms": 702960,
   "text": "おじさん"
  },
  {
   "start_ms": 702960,
   "end_ms": 703960,
   "text": "おじさん"
  },
  {
   "start_ms": 703960,
   "end_ms": 704960,
   "text": "高踏み"
  },
  {
   "start_ms": 705960,
   "end_ms": 708960,
   "text": "セガのハードを選んだ人間が"
  },
  {
   "start_ms": 708960,
   "end_ms": 711960,
   "text": "そういった人生を歩めると思うなよ"
  },
  {
   "start_ms": 714960,
   "end_ms": 715960,
   "text": "この人はなんで"
  },
  {
   "start_ms": 715960,
   "end_ms": 718960,
   "text": "ゲーム機にそこまで人生を引っ張られてるんだろう"
  },
  {
   "start_ms": 722960,
   "end_ms": 723960,
   "text": "うん"
  },
  {
   "start_ms": 723960,
   "end_ms": 725960,
   "text": "そのオクションが最安みたいだね"
  },
  {
   "start_ms": 725960,
   "end_ms": 726960,
   "text": "もう調べたのか"
  },
  {
   "start_ms": 726960,
   "end_ms": 728960,
   "text": "そんなに小さいのに"
  },
  {
   "start_ms": 728960,
   "end_ms": 729960,
   "text": "スマホはすげーな"
  },
  {
   "start_ms": 729960,
   "end_ms": 731960,
   "text": "おじさんも覚えるはすぐだよ"
  },
  {
   "start_ms": 732960,
   "end_ms": 734960,
   "text": "タッチにスワイプ"
  },
  {
   "start_ms": 734960,
   "end_ms": 735960,
   "text": "ピンチアウトか"
  },
  {
   "start_ms": 735960,
   "end_ms": 738960,
   "text": "とりあえずボタンいっぱいついてるやつ触りたい"
  },
  {
   "start_ms": 738960,
   "end_ms": 739960,
   "text": "そうなんだ"
  },
  {
   "start_ms": 739960,
   "end_ms": 740960,
   "text": "しかし"
  },
  {
   "start_ms": 740960,
   "end_ms": 743960,
   "text": "開いたりスライドしたり回ったり"
  },
  {
   "start_ms": 743960,
   "end_ms": 745960,
   "text": "かっこいいのは全部なくなってしまったんだな"
  },
  {
   "start_ms": 745960,
   "end_ms": 747960,
   "text": "技術革新だね"
  },
  {
   "start_ms": 747960,
   "end_ms": 749960,
   "text": "今はタッチパネルだよ"
  },
  {
   "start_ms": 749960,
   "end_ms": 751960,
   "text": "17年もたてばそうなるか"
  },
  {
   "start_ms": 751960,
   "end_ms": 753960,
   "text": "そういえば俺も"
  },
  {
   "start_ms": 753960,
   "end_ms": 756960,
   "text": "異世界で一つ技術革新をやったぞ"
  },
  {
   "start_ms": 756960,
   "end_ms": 757960,
   "text": "何やったの"
  },
  {
   "start_ms": 758960,
   "end_ms": 760960,
   "text": "完罰に苦しむ村で"
  },
  {
   "start_ms": 760960,
   "end_ms": 762960,
   "text": "水の湧き出るツボを作った"
  },
  {
   "start_ms": 762960,
   "end_ms": 764960,
   "text": "すごい!どうやって"
  },
  {
   "start_ms": 765960,
   "end_ms": 767960,
   "text": "二つの魔法を"
  },
  {
   "start_ms": 767960,
   "end_ms": 770960,
   "text": "頭の中を見せた方が早いな"
  },
  {
   "start_ms": 770960,
   "end_ms": 772960,
   "text": "イキラスエルラン"
  },
  {
   "start_ms": 776960,
   "end_ms": 777960,
   "text": "これは"
  },
  {
   "start_ms": 779960,
   "end_ms": 781960,
   "text": "異世界でのおじさんの記憶"
  },
  {
   "start_ms": 781960,
   "end_ms": 783960,
   "text": "魔法を込めた札"
  },
  {
   "start_ms": 783960,
   "end_ms": 785960,
   "text": "ジュフってのがあってな"
  },
  {
   "start_ms": 786960,
   "end_ms": 788960,
   "text": "詳細は省くが"
  },
  {
   "start_ms": 788960,
   "end_ms": 791960,
   "text": "水の電気分解の逆をやったらうまくいった"
  },
  {
   "start_ms": 792960,
   "end_ms": 794960,
   "text": "現代科学無双"
  },
  {
   "start_ms": 794960,
   "end_ms": 797960,
   "text": "おじさん異世界を大化してたんだね"
  },
  {
   "start_ms": 797960,
   "end_ms": 798960,
   "text": "すごかったでしょ"
  },
  {
   "start_ms": 798960,
   "end_ms": 800960,
   "text": "感謝と尊敬の声"
  },
  {
   "start_ms": 800960,
   "end_ms": 802960,
   "text": "いや"
  },
  {
   "start_ms": 806960,
   "end_ms": 808960,
   "text": "ツルされかけた"
  },
  {
   "start_ms": 810960,
   "end_ms": 812960,
   "text": "ツボは叩き壊された"
  },
  {
   "start_ms": 815960,
   "end_ms": 818960,
   "text": "どうやら宗教的にまずかったようだ"
  },
  {
   "start_ms": 818960,
   "end_ms": 819960,
   "text": "待て"
  },
  {
   "start_ms": 821960,
   "end_ms": 823960,
   "text": "誰か助けに入ったよ"
  },
  {
   "start_ms": 823960,
   "end_ms": 825960,
   "text": "ああ 例の嫌がらせのやつだ"
  },
  {
   "start_ms": 825960,
   "end_ms": 827960,
   "text": "え この人が"
  },
  {
   "start_ms": 827960,
   "end_ms": 829960,
   "text": "確かにこの男は邪悪な顔している"
  },
  {
   "start_ms": 829960,
   "end_ms": 831960,
   "text": "オークそのものだ"
  },
  {
   "start_ms": 831960,
   "end_ms": 833960,
   "text": "不思議に思うのも無理はない"
  },
  {
   "start_ms": 833960,
   "end_ms": 834960,
   "text": "しかし"
  },
  {
   "start_ms": 834960,
   "end_ms": 836960,
   "text": "ワーグルットグラッカー"
  },
  {
   "start_ms": 839960,
   "end_ms": 841960,
   "text": "うまいった"
  },
  {
   "start_ms": 841960,
   "end_ms": 843960,
   "text": "まあ こんな感じだな"
  },
  {
   "start_ms": 846960,
   "end_ms": 848960,
   "text": "だよな"
  },
  {
   "start_ms": 849960,
   "end_ms": 850960,
   "text": "見づらいよな"
  },
  {
   "start_ms": 850960,
   "end_ms": 852960,
   "text": "一任賞視点"
  },
  {
   "start_ms": 852960,
   "end_ms": 853960,
   "text": "え そこ?"
  },
  {
   "start_ms": 854960,
   "end_ms": 855960,
   "text": "んーと"
  },
  {
   "start_ms": 855960,
   "end_ms": 856960,
   "text": "こうスワイプして"
  },
  {
   "start_ms": 856960,
   "end_ms": 857960,
   "text": "カメラ帰って"
  },
  {
   "start_ms": 857960,
   "end_ms": 859960,
   "text": "あ 出来た"
  },
  {
   "start_ms": 859960,
   "end_ms": 860960,
   "text": "できるの?"
  },
  {
   "start_ms": 860960,
   "end_ms": 862960,
   "text": "ピンチインでしくしょうと"
  },
  {
   "start_ms": 862960,
   "end_ms": 863960,
   "text": "うわ"
  },
  {
   "start_ms": 863960,
   "end_ms": 865960,
   "text": "かなり枯れかけてるし"
  },
  {
   "start_ms": 865960,
   "end_ms": 866960,
   "text": "あ"
  },
  {
   "start_ms": 866960,
   "end_ms": 867960,
   "text": "じゃあさっきの人"
  },
  {
   "start_ms": 867960,
   "end_ms": 868960,
   "text": "どうなったか見れる"
  },
  {
   "start_ms": 868960,
   "end_ms": 869960,
   "text": "おお"
  },
  {
   "start_ms": 869960,
   "end_ms": 871960,
   "text": "じゃあ ピンチアウトで拡大"
  },
  {
   "start_ms": 872960,
   "end_ms": 874960,
   "text": "あの奥両者"
  },
  {
   "start_ms": 874960,
   "end_ms": 876960,
   "text": "逃げたのね"
  },
  {
   "start_ms": 885960,
   "end_ms": 887960,
   "text": "めっちゃいい人だ"
  },
  {
   "start_ms": 887960,
   "end_ms": 889960,
   "text": "しかも美人"
  },
  {
   "start_ms": 889960,
   "end_ms": 891960,
   "text": "はい はい 奥両 奥両"
  },
  {
   "start_ms": 891960,
   "end_ms": 892960,
   "text": "えっ"
  },
  {
   "start_ms": 893960,
   "end_ms": 895960,
   "text": "ああ オーク"
  },
  {
   "start_ms": 895960,
   "end_ms": 897960,
   "text": "時間がない"
  },
  {
   "start_ms": 897960,
   "end_ms": 899960,
   "text": "ああ"
  },
  {
   "start_ms": 900960,
   "end_ms": 902960,
   "text": "ああ"
  },
  {
   "start_ms": 902960,
   "end_ms": 904960,
   "text": "逃げさせるぞ"
  },
  {
   "start_ms": 904960,
   "end_ms": 906960,
   "text": "そう 奥両は調べた"
  },
  {
   "start_ms": 914960,
   "end_ms": 916960,
   "text": "奥両 2000円"
  },
  {
   "start_ms": 916960,
   "end_ms": 919960,
   "text": "住所 聞いたこともない離島だね"
  },
  {
   "start_ms": 921960,
   "end_ms": 923960,
   "text": "直接会って取引できれば"
  },
  {
   "start_ms": 923960,
   "end_ms": 925960,
   "text": "奥両ただなんだけど"
  },
  {
   "start_ms": 930960,
   "end_ms": 932960,
   "text": "奥両"
  },
  {
   "start_ms": 941960,
   "end_ms": 943960,
   "text": "おじさん"
  },
  {
   "start_ms": 946960,
   "end_ms": 948960,
   "text": "ちょっと行ってくる"
  },
  {
   "start_ms": 956960,
   "end_ms": 958960,
   "text": "ただいま"
  },
  {
   "start_ms": 960960,
   "end_ms": 962960,
   "text": "おじさん"
  },
  {
   "start_ms": 964960,
   "end_ms": 966960,
   "text": "このヘッドホン"
  },
  {
   "start_ms": 966960,
   "end_ms": 967960,
   "text": "行ける"
  },
  {
   "start_ms": 967960,
   "end_ms": 968960,
   "text": "出品どこ"
  },
  {
   "start_ms": 968960,
   "end_ms": 970960,
   "text": "熊本"
  },
  {
   "start_ms": 970960,
   "end_ms": 972960,
   "text": "5分だな"
  },
  {
   "start_ms": 973960,
   "end_ms": 975960,
   "text": "このソファーは"
  },
  {
   "start_ms": 975960,
   "end_ms": 977960,
   "text": "いやー絶対重いだろう"
  },
  {
   "start_ms": 977960,
   "end_ms": 979960,
   "text": "帰ってきたら肩もむから"
  },
  {
   "start_ms": 979960,
   "end_ms": 980960,
   "text": "ああ"
  },
  {
   "start_ms": 980960,
   "end_ms": 981960,
   "text": "じゃあ行ける"
  },
  {
   "start_ms": 981960,
   "end_ms": 982960,
   "text": "おじさんが"
  },
  {
   "start_ms": 982960,
   "end_ms": 985960,
   "text": "奥両無料で落札する能力を覚えた"
  },
  {
   "start_ms": 986960,
   "end_ms": 988960,
   "text": "だま"
  },
  {
   "start_ms": 989960,
   "end_ms": 990960,
   "text": "なんだ"
  },
  {
   "start_ms": 990960,
   "end_ms": 992960,
   "text": "荷物なら取りに行ったのに"
  },
  {
   "start_ms": 992960,
   "end_ms": 994960,
   "text": "これはアマゾンの特売の米"
  },
  {
   "start_ms": 994960,
   "end_ms": 996960,
   "text": "その辺に勝ったない?"
  },
  {
   "start_ms": 996960,
   "end_ms": 997960,
   "text": "ん?"
  },
  {
   "start_ms": 997960,
   "end_ms": 998960,
   "text": "はい"
  },
  {
   "start_ms": 998960,
   "end_ms": 999960,
   "text": "ありがとう"
  },
  {
   "start_ms": 1002960,
   "end_ms": 1003960,
   "text": "えっ"
  },
  {
   "start_ms": 1003960,
   "end_ms": 1004960,
   "text": "なにこれ どこから出したの"
  },
  {
   "start_ms": 1004960,
   "end_ms": 1006960,
   "text": "収納魔法だよ"
  },
  {
   "start_ms": 1006960,
   "end_ms": 1007960,
   "text": "あとそれ"
  },
  {
   "start_ms": 1007960,
   "end_ms": 1009960,
   "text": "ドラゴン殺せる奴だから注意してね"
  },
  {
   "start_ms": 1009960,
   "end_ms": 1011960,
   "text": "それ病院の時の"
  },
  {
   "start_ms": 1011960,
   "end_ms": 1013960,
   "text": "他に異世界から持ってきて"
  },
  {
   "start_ms": 1013960,
   "end_ms": 1016960,
   "text": "他に異世界から持ってきたものはないの"
  },
  {
   "start_ms": 1016960,
   "end_ms": 1017960,
   "text": "ん?"
  },
  {
   "start_ms": 1017960,
   "end_ms": 1018960,
   "text": "あるぞ"
  },
  {
   "start_ms": 1019960,
   "end_ms": 1021960,
   "text": "この魔剣とか"
  },
  {
   "start_ms": 1023960,
   "end_ms": 1024960,
   "text": "しっききん"
  },
  {
   "start_ms": 1024960,
   "end_ms": 1025960,
   "text": "あと"
  },
  {
   "start_ms": 1025960,
   "end_ms": 1027960,
   "text": "貴金属なんかも"
  },
  {
   "start_ms": 1027960,
   "end_ms": 1029960,
   "text": "これは人魚の涙を魔法で"
  },
  {
   "start_ms": 1029960,
   "end_ms": 1031960,
   "text": "化粧化したものでな"
  },
  {
   "start_ms": 1031960,
   "end_ms": 1033960,
   "text": "リングは7色3号の削りだし"
  },
  {
   "start_ms": 1033960,
   "end_ms": 1035960,
   "text": "異世界ではこれ1個で"
  },
  {
   "start_ms": 1035960,
   "end_ms": 1037960,
   "text": "城が立つほどだ"
  },
  {
   "start_ms": 1038960,
   "end_ms": 1040960,
   "text": "50円"
  },
  {
   "start_ms": 1041960,
   "end_ms": 1043960,
   "text": "七夜持ってったら"
  },
  {
   "start_ms": 1043960,
   "end_ms": 1044960,
   "text": "50円って言われた"
  },
  {
   "start_ms": 1044960,
   "end_ms": 1046960,
   "text": "貴重すぎた"
  },
  {
   "start_ms": 1048960,
   "end_ms": 1050960,
   "text": "再生数の伸びが今一つだな"
  },
  {
   "start_ms": 1050960,
   "end_ms": 1052960,
   "text": "何かワンアイデア"
  },
  {
   "start_ms": 1052960,
   "end_ms": 1053960,
   "text": "おじさん"
  },
  {
   "start_ms": 1053960,
   "end_ms": 1054960,
   "text": "ん?"
  },
  {
   "start_ms": 1054960,
   "end_ms": 1056960,
   "text": "こういう指を持ってるってことは"
  },
  {
   "start_ms": 1056960,
   "end_ms": 1058960,
   "text": "異世界に送る相手とかいたの?"
  },
  {
   "start_ms": 1058960,
   "end_ms": 1061960,
   "text": "いや 宝石は単なる記念トロフィーだな"
  },
  {
   "start_ms": 1061960,
   "end_ms": 1064960,
   "text": "結構大変なダンジョンをクリアしないと"
  },
  {
   "start_ms": 1064960,
   "end_ms": 1065960,
   "text": "手に入らないんだ"
  },
  {
   "start_ms": 1065960,
   "end_ms": 1067960,
   "text": "そうなんだ"
  },
  {
   "start_ms": 1071960,
   "end_ms": 1073960,
   "text": "コイバナをしたいのか"
  },
  {
   "start_ms": 1073960,
   "end_ms": 1074960,
   "text": "いや"
  },
  {
   "start_ms": 1074960,
   "end_ms": 1075960,
   "text": "おじさんそういうの"
  },
  {
   "start_ms": 1075960,
   "end_ms": 1077960,
   "text": "あんま興味なさそうだし"
  },
  {
   "start_ms": 1077960,
   "end_ms": 1078960,
   "text": "いいよ"
  },
  {
   "start_ms": 1078960,
   "end_ms": 1079960,
   "text": "馬鹿言え"
  },
  {
   "start_ms": 1079960,
   "end_ms": 1081960,
   "text": "俺だって30年以上も生きてれば"
  },
  {
   "start_ms": 1081960,
   "end_ms": 1083960,
   "text": "それなりにいろいろある"
  },
  {
   "start_ms": 1084960,
   "end_ms": 1087960,
   "text": "初恋は小学校の時だったか"
  },
  {
   "start_ms": 1087960,
   "end_ms": 1088960,
   "text": "どんな子?"
  },
  {
   "start_ms": 1089960,
   "end_ms": 1091960,
   "text": "ソニックとテイルスだ"
  },
  {
   "start_ms": 1091960,
   "end_ms": 1092960,
   "text": "は?"
  },
  {
   "start_ms": 1093960,
   "end_ms": 1095960,
   "text": "おもちゃ屋の店頭でも"
  },
  {
   "start_ms": 1095960,
   "end_ms": 1098960,
   "text": "毎日通ってずーっと見てた"
  },
  {
   "start_ms": 1100960,
   "end_ms": 1102960,
   "text": "タイトル画面が可愛くて"
  },
  {
   "start_ms": 1102960,
   "end_ms": 1104960,
   "text": "どれだけ見てても見焼きない"
  },
  {
   "start_ms": 1104960,
   "end_ms": 1106960,
   "text": "人間相手の話はないの?"
  },
  {
   "start_ms": 1106960,
   "end_ms": 1108960,
   "text": "ん?あるぞ"
  },
  {
   "start_ms": 1108960,
   "end_ms": 1110960,
   "text": "七世会でという"
  },
  {
   "start_ms": 1110960,
   "end_ms": 1112960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1112960,
   "end_ms": 1113960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1113960,
   "end_ms": 1114960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1114960,
   "end_ms": 1115960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1115960,
   "end_ms": 1116960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1116960,
   "end_ms": 1117960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1117960,
   "end_ms": 1118960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1118960,
   "end_ms": 1119960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1119960,
   "end_ms": 1121960,
   "text": "彼女の子"
  },
  {
   "start_ms": 1121960,
   "end_ms": 1124960,
   "text": "七世会でという中のいい女の子だった"
  },
  {
   "start_ms": 1124960,
   "end_ms": 1127960,
   "text": "敵資料に殺害された彼女は"
  },
  {
   "start_ms": 1127960,
   "end_ms": 1130960,
   "text": "生態コンピューターの自動に改造素性され"
  },
  {
   "start_ms": 1130960,
   "end_ms": 1131960,
   "text": "急性兵器"
  },
  {
   "start_ms": 1131960,
   "end_ms": 1133960,
   "text": "セブンフォースを借り襲ってくるんだ"
  },
  {
   "start_ms": 1133960,
   "end_ms": 1135960,
   "text": "ステージさんのボスとして"
  },
  {
   "start_ms": 1135960,
   "end_ms": 1136960,
   "text": "ご携帯の"
  },
  {
   "start_ms": 1136960,
   "end_ms": 1137960,
   "text": "この人"
  },
  {
   "start_ms": 1137960,
   "end_ms": 1139960,
   "text": "ゲーム以外に人生何もないのか"
  },
  {
   "start_ms": 1140960,
   "end_ms": 1142960,
   "text": "い、異世界ではいい子いなかったの"
  },
  {
   "start_ms": 1142960,
   "end_ms": 1144960,
   "text": "ん?いたぞ"
  },
  {
   "start_ms": 1145960,
   "end_ms": 1147960,
   "text": "イキュラス"
  },
  {
   "start_ms": 1147960,
   "end_ms": 1148960,
   "text": "エルラン"
  },
  {
   "start_ms": 1152960,
   "end_ms": 1155960,
   "text": "ギュラス"
  },
  {
   "start_ms": 1172960,
   "end_ms": 1174960,
   "text": "ステージさん"
  },
  {
   "start_ms": 1174960,
   "end_ms": 1175960,
   "text": "ステージさん"
  },
  {
   "start_ms": 1175960,
   "end_ms": 1176960,
   "text": "ステージさん"
  },
  {
   "start_ms": 1176960,
   "end_ms": 1177960,
   "text": "ステージさん"
  },
  {
   "start_ms": 1177960,
   "end_ms": 1179960,
   "text": "ん"
  },
  {
   "start_ms": 1201720,
   "end_ms": 1205200,
   "text": "こんな感じでモンスターから守ってやったんだ"
  },
  {
   "start_ms": 1205800,
   "end_ms": 1209840,
   "text": "どう見ても自分を犠牲にして弟たちを守ろうとしていた"
  },
  {
   "start_ms": 1209840,
   "end_ms": 1211520,
   "text": "いい感じだろ"
  },
  {
   "start_ms": 1211520,
   "end_ms": 1216000,
   "text": "でもこの直後ゴブリンか何かに四角から襲われてな"
  },
  {
   "start_ms": 1216000,
   "end_ms": 1218800,
   "text": "崖から落とされてそれっきりなんだよ"
  },
  {
   "start_ms": 1218800,
   "end_ms": 1220800,
   "text": "それは酷い目にあったね"
  },
  {
   "start_ms": 1223800,
   "end_ms": 1227760,
   "text": "今弟二人がすごいめつきで後ろに回り込んでたな"
  },
  {
   "start_ms": 1227760,
   "end_ms": 1229840,
   "text": "何に襲われたのか見てみるか"
  },
  {
   "start_ms": 1229840,
   "end_ms": 1231760,
   "text": "きっとゴブリンだよ"
  },
  {
   "start_ms": 1231760,
   "end_ms": 1232400,
   "text": "そう?"
  },
  {
   "start_ms": 1232400,
   "end_ms": 1234400,
   "text": "そう!絶対そう!"
  },
  {
   "start_ms": 1235360,
   "end_ms": 1239440,
   "text": "まあそれで死にかけたところにたまたま例のやつがいてな"
  },
  {
   "start_ms": 1239440,
   "end_ms": 1240000,
   "text": "え?"
  },
  {
   "start_ms": 1240000,
   "end_ms": 1242400,
   "text": "悔しいがそれで助かった"
  },
  {
   "start_ms": 1254400,
   "end_ms": 1255600,
   "text": "お前"
  },
  {
   "start_ms": 1256720,
   "end_ms": 1257920,
   "text": "なぜ俺を?"
  },
  {
   "start_ms": 1257920,
   "end_ms": 1259680,
   "text": "勘違いしないで"
  },
  {
   "start_ms": 1259680,
   "end_ms": 1261040,
   "text": "これは貸しよ"
  },
  {
   "start_ms": 1261040,
   "end_ms": 1264320,
   "text": "障害かけてジベタを張って継ぐなうといいわ"
  },
  {
   "start_ms": 1266160,
   "end_ms": 1267520,
   "text": "障害"
  },
  {
   "start_ms": 1267520,
   "end_ms": 1268400,
   "text": "え?"
  },
  {
   "start_ms": 1271360,
   "end_ms": 1272960,
   "text": "ち、違うわよ"
  },
  {
   "start_ms": 1272960,
   "end_ms": 1275760,
   "text": "ずっと一緒にとか変な意味に取らないでよ"
  },
  {
   "start_ms": 1277280,
   "end_ms": 1279360,
   "text": "あ、ちょ、なに?"
  },
  {
   "start_ms": 1279360,
   "end_ms": 1280320,
   "text": "寄らないで"
  },
  {
   "start_ms": 1280320,
   "end_ms": 1283040,
   "text": "そんな大きな狩りは作りたくない"
  },
  {
   "start_ms": 1283040,
   "end_ms": 1284400,
   "text": "これでどうだ"
  },
  {
   "start_ms": 1284400,
   "end_ms": 1285040,
   "text": "え?"
  },
  {
   "start_ms": 1288240,
   "end_ms": 1291920,
   "text": "世界に七つしかないと言われる天聖席の指輪だ"
  },
  {
   "start_ms": 1291920,
   "end_ms": 1292880,
   "text": "ちょ、無理なに?"
  },
  {
   "start_ms": 1292880,
   "end_ms": 1293840,
   "text": "どうする気よ"
  },
  {
   "start_ms": 1294000,
   "end_ms": 1294800,
   "text": "あ!"
  },
  {
   "start_ms": 1299679,
   "end_ms": 1300800,
   "text": "サイズは会うか?"
  },
  {
   "start_ms": 1300800,
   "end_ms": 1302959,
   "text": "え、ま、まってまって"
  },
  {
   "start_ms": 1304560,
   "end_ms": 1306080,
   "text": "そんな急に"
  },
  {
   "start_ms": 1306080,
   "end_ms": 1307120,
   "text": "いらないのか?"
  },
  {
   "start_ms": 1314480,
   "end_ms": 1315280,
   "text": "いる"
  },
  {
   "start_ms": 1315600,
   "end_ms": 1318879,
   "text": "おじさんがなんかとんでもないことをしようとしてる"
  },
  {
   "start_ms": 1319600,
   "end_ms": 1321680,
   "text": "大丈夫なの?こんなことして"
  },
  {
   "start_ms": 1321680,
   "end_ms": 1324480,
   "text": "反応を見る限り異世界でもそういうことだよ"
  },
  {
   "start_ms": 1324480,
   "end_ms": 1326000,
   "text": "責任とかって"
  },
  {
   "start_ms": 1326000,
   "end_ms": 1327200,
   "text": "当たり前だろう"
  },
  {
   "start_ms": 1329360,
   "end_ms": 1330720,
   "text": "ちゃんと責任持って"
  },
  {
   "start_ms": 1330720,
   "end_ms": 1332720,
   "text": "次の街で勘勤してやった"
  },
  {
   "start_ms": 1332720,
   "end_ms": 1334240,
   "text": "おじさん!"
  },
  {
   "start_ms": 1346240,
   "end_ms": 1348639,
   "text": "どこかの街で舞いたって言ってたけど"
  },
  {
   "start_ms": 1348639,
   "end_ms": 1350240,
   "text": "この街だったんだね"
  },
  {
   "start_ms": 1350240,
   "end_ms": 1352720,
   "text": "いや、このあとも突きまとばれた"
  },
  {
   "start_ms": 1352720,
   "end_ms": 1354800,
   "text": "金に味を占めたのかな"
  },
  {
   "start_ms": 1354800,
   "end_ms": 1356560,
   "text": "銀行に預けてきたわ"
  },
  {
   "start_ms": 1356560,
   "end_ms": 1358000,
   "text": "次はどこに行くっき?"
  },
  {
   "start_ms": 1358000,
   "end_ms": 1359360,
   "text": "え?ここで休む?"
  },
  {
   "start_ms": 1359360,
   "end_ms": 1361200,
   "text": "それは気分で渡しまうの"
  },
  {
   "start_ms": 1361200,
   "end_ms": 1363040,
   "text": "た、タフだな"
  },
  {
   "start_ms": 1364320,
   "end_ms": 1366000,
   "text": "まあ、こんな感じで"
  },
  {
   "start_ms": 1366000,
   "end_ms": 1367840,
   "text": "こういう希少アイテムは"
  },
  {
   "start_ms": 1367840,
   "end_ms": 1369840,
   "text": "何かと使い勝手がいいんだ"
  },
  {
   "start_ms": 1369840,
   "end_ms": 1372800,
   "text": "ああ、そのナイフもここにしまってくれ"
  },
  {
   "start_ms": 1372800,
   "end_ms": 1373440,
   "text": "うん"
  },
  {
   "start_ms": 1376240,
   "end_ms": 1378240,
   "text": "おじさんの新ネタは"
  },
  {
   "start_ms": 1378240,
   "end_ms": 1380240,
   "text": "再生数200万を超えた"
  },
  {
   "start_ms": 1406240,
   "end_ms": 1409280,
   "text": "2017年"
  },
  {
   "start_ms": 1409280,
   "end_ms": 1411280,
   "text": "秋"
  },
  {
   "start_ms": 1411280,
   "end_ms": 1413280,
   "text": "おじさんとの生活は"
  },
  {
   "start_ms": 1413280,
   "end_ms": 1415280,
   "text": "始まったばかりだった"
  }
 ],
