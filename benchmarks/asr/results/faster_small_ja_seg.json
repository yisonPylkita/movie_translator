 "segments": [
  {
   "start_ms": 0,
   "end_ms": 2000,
   "text": "ん"
  },
  {
   "start_ms": 6200,
   "end_ms": 12040,
   "text": "姉ちゃんの子供の高踏みか 大きくなったなぁ"
  },
  {
   "start_ms": 12040,
   "end_ms": 15000,
   "text": "他のみんなは"
  },
  {
   "start_ms": 16360,
   "end_ms": 22160,
   "text": "混水状態のおじさんの食うを巡って 言っちゃいけないことをボロクスを言い合ったあげく"
  },
  {
   "start_ms": 22160,
   "end_ms": 29720,
   "text": "一家離散したよ うちの母さんも正直会いたくないって"
  },
  {
   "start_ms": 31000,
   "end_ms": 35000,
   "text": "行くらすキューラ"
  },
  {
   "start_ms": 35000,
   "end_ms": 37000,
   "text": "ふぅ"
  },
  {
   "start_ms": 37000,
   "end_ms": 39000,
   "text": "さて"
  },
  {
   "start_ms": 39000,
   "end_ms": 42000,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 42000,
   "end_ms": 45000,
   "text": "え? いやいいです"
  },
  {
   "start_ms": 45000,
   "end_ms": 48000,
   "text": "ワーグレントセルド"
  },
  {
   "start_ms": 50000,
   "end_ms": 52000,
   "text": "あれ?"
  },
  {
   "start_ms": 52000,
   "end_ms": 54000,
   "text": "ワーグレントマグナ!"
  },
  {
   "start_ms": 57000,
   "end_ms": 59000,
   "text": "ワーグレントラルド"
  },
  {
   "start_ms": 59000,
   "end_ms": 61000,
   "text": "ワーグレントラルド"
  },
  {
   "start_ms": 61000,
   "end_ms": 63000,
   "text": "ワーグレントガッド"
  },
  {
   "start_ms": 63000,
   "end_ms": 65000,
   "text": "ワーグレントパッド"
  },
  {
   "start_ms": 65000,
   "end_ms": 69000,
   "text": "あのさ、不景気でうちも厳しくてさ"
  },
  {
   "start_ms": 69000,
   "end_ms": 72000,
   "text": "これもいろいろあってバイトしてるし"
  },
  {
   "start_ms": 72000,
   "end_ms": 75000,
   "text": "知律支援とかあれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 75000,
   "end_ms": 77000,
   "text": "火星を運べ"
  },
  {
   "start_ms": 86000,
   "end_ms": 88000,
   "text": "マジかよ!"
  },
  {
   "start_ms": 88000,
   "end_ms": 90000,
   "text": "戻せ"
  },
  {
   "start_ms": 91000,
   "end_ms": 93000,
   "text": "こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 108000,
   "end_ms": 110000,
   "text": "本物だ"
  },
  {
   "start_ms": 111000,
   "end_ms": 116000,
   "text": "というか、なんか結構エグいことを言おうとしてなかった"
  },
  {
   "start_ms": 116000,
   "end_ms": 117000,
   "text": "言ってないよ"
  },
  {
   "start_ms": 118000,
   "end_ms": 119000,
   "text": "ほんと?"
  },
  {
   "start_ms": 119000,
   "end_ms": 121000,
   "text": "それよりさっきの何?"
  },
  {
   "start_ms": 121000,
   "end_ms": 123000,
   "text": "魔法だよ"
  },
  {
   "start_ms": 123000,
   "end_ms": 125000,
   "text": "火星"
  },
  {
   "start_ms": 125000,
   "end_ms": 128000,
   "text": "すごい!それどうやって出してるの?"
  },
  {
   "start_ms": 128000,
   "end_ms": 131000,
   "text": "そんなことよりゲームハードセンスはどうなった"
  },
  {
   "start_ms": 131000,
   "end_ms": 132000,
   "text": "セガは"
  },
  {
   "start_ms": 132000,
   "end_ms": 133000,
   "text": "え?"
  },
  {
   "start_ms": 133000,
   "end_ms": 134000,
   "text": "セガ?"
  },
  {
   "start_ms": 134000,
   "end_ms": 136000,
   "text": "い、今"
  },
  {
   "start_ms": 136000,
   "end_ms": 141000,
   "text": "国内だと、ソニーとニンテンドーガー二挙って感じかな"
  },
  {
   "start_ms": 141000,
   "end_ms": 143000,
   "text": "は?セガは?"
  },
  {
   "start_ms": 143000,
   "end_ms": 144000,
   "text": "ね、それ今…"
  },
  {
   "start_ms": 144000,
   "end_ms": 146000,
   "text": "セガは?"
  },
  {
   "start_ms": 146000,
   "end_ms": 149000,
   "text": "いや、特に撤退したけど"
  },
  {
   "start_ms": 153000,
   "end_ms": 155000,
   "text": "イキュラスキオラ"
  },
  {
   "start_ms": 156000,
   "end_ms": 159000,
   "text": "ねえ、そのイキュラスキオラって何?"
  },
  {
   "start_ms": 159000,
   "end_ms": 163000,
   "text": "おぉ、記憶消去の魔法だな"
  },
  {
   "start_ms": 163000,
   "end_ms": 166000,
   "text": "耐えがたいことがあると使うんだ"
  },
  {
   "start_ms": 166000,
   "end_ms": 168000,
   "text": "セガの剣ってそんなに?"
  },
  {
   "start_ms": 168000,
   "end_ms": 171000,
   "text": "異世界は辛いことが多くてなぁ"
  },
  {
   "start_ms": 171000,
   "end_ms": 173000,
   "text": "見るか"
  },
  {
   "start_ms": 173000,
   "end_ms": 175000,
   "text": "うん"
  },
  {
   "start_ms": 176000,
   "end_ms": 179000,
   "text": "あ゛ぁ゛ぁ"
  }
 ],
