 "segments": [
  {
   "start_ms": 0,
   "end_ms": 8500,
   "text": "姉ちゃんの子供の高文か"
  },
  {
   "start_ms": 8500,
   "end_ms": 10820,
   "text": "大きくなったな"
  },
  {
   "start_ms": 10820,
   "end_ms": 13180,
   "text": "他のみんなは"
  },
  {
   "start_ms": 13180,
   "end_ms": 18940,
   "text": "渾水状態のおじさんの処遇をめぐって"
  },
  {
   "start_ms": 18940,
   "end_ms": 22100,
   "text": "言っちゃいけないことをボロクソ言い合った挙句"
  },
  {
   "start_ms": 22100,
   "end_ms": 23620,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 23620,
   "end_ms": 28020,
   "text": "うちの母さんも正直会いたくないって"
  },
  {
   "start_ms": 28020,
   "end_ms": 34280,
   "text": "イキュラス・キュオラ"
  },
  {
   "start_ms": 34280,
   "end_ms": 37180,
   "text": "ふぅー"
  },
  {
   "start_ms": 37180,
   "end_ms": 41920,
   "text": "さて異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 41920,
   "end_ms": 44580,
   "text": "え?いやいいです"
  },
  {
   "start_ms": 44580,
   "end_ms": 46960,
   "text": "ワーグレント・セルド"
  },
  {
   "start_ms": 46960,
   "end_ms": 50880,
   "text": "あれ"
  },
  {
   "start_ms": 50880,
   "end_ms": 53480,
   "text": "ワーグレント・マグナ"
  },
  {
   "start_ms": 53480,
   "end_ms": 58000,
   "text": "ワーグレント・ラッキー"
  },
  {
   "start_ms": 58020,
   "end_ms": 60020,
   "text": "ワーグレント・ネルド"
  },
  {
   "start_ms": 60020,
   "end_ms": 62340,
   "text": "ワーグレント・ガッド"
  },
  {
   "start_ms": 62340,
   "end_ms": 63900,
   "text": "ワーグレント・パッド"
  },
  {
   "start_ms": 63900,
   "end_ms": 67900,
   "text": "あのさ不景気でうちも厳しくてさ"
  },
  {
   "start_ms": 67900,
   "end_ms": 69060,
   "text": "ワーグレント・スラドセット"
  },
  {
   "start_ms": 69060,
   "end_ms": 71060,
   "text": "俺もいろいろあってバイトしてるし"
  },
  {
   "start_ms": 71060,
   "end_ms": 74880,
   "text": "自立支援とかあれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 74880,
   "end_ms": 76060,
   "text": "課税を運べ"
  },
  {
   "start_ms": 76060,
   "end_ms": 82700,
   "text": "はぁ?"
  },
  {
   "start_ms": 82700,
   "end_ms": 84620,
   "text": "はぁ?"
  },
  {
   "start_ms": 84620,
   "end_ms": 86780,
   "text": "マジかよ!"
  },
  {
   "start_ms": 86780,
   "end_ms": 88000,
   "text": "課税を持ってきてるんだよ"
  },
  {
   "start_ms": 88020,
   "end_ms": 88400,
   "text": "戻せ"
  },
  {
   "start_ms": 88400,
   "end_ms": 93020,
   "text": "こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 93020,
   "end_ms": 109360,
   "text": "本物だ"
  },
  {
   "start_ms": 109360,
   "end_ms": 112440,
   "text": "というか"
  },
  {
   "start_ms": 112440,
   "end_ms": 115600,
   "text": "なんか結構エグいこと言おうとしてなかった?"
  },
  {
   "start_ms": 115600,
   "end_ms": 116740,
   "text": "言ってないよ"
  },
  {
   "start_ms": 118020,
   "end_ms": 118520,
   "text": "本当?"
  },
  {
   "start_ms": 118520,
   "end_ms": 120020,
   "text": "それよりさっきの何?"
  },
  {
   "start_ms": 120020,
   "end_ms": 120520,
   "text": "あ"
  },
  {
   "start_ms": 120520,
   "end_ms": 122020,
   "text": "魔法だよ"
  },
  {
   "start_ms": 122020,
   "end_ms": 123640,
   "text": "火を"
  },
  {
   "start_ms": 123640,
   "end_ms": 126300,
   "text": "あ!すごい!"
  },
  {
   "start_ms": 126300,
   "end_ms": 127740,
   "text": "それどうやって出してるの?"
  },
  {
   "start_ms": 127740,
   "end_ms": 130940,
   "text": "そんなことよりゲームハードセンスはどうなった?"
  },
  {
   "start_ms": 130940,
   "end_ms": 131780,
   "text": "セガは?"
  },
  {
   "start_ms": 131780,
   "end_ms": 132280,
   "text": "え?"
  },
  {
   "start_ms": 132280,
   "end_ms": 133960,
   "text": "セガ?"
  },
  {
   "start_ms": 133960,
   "end_ms": 135400,
   "text": "い、今?"
  },
  {
   "start_ms": 135400,
   "end_ms": 140680,
   "text": "国内だとソニーとニンテンドーが二強って感じかな"
  },
  {
   "start_ms": 140680,
   "end_ms": 142480,
   "text": "は?セガは?"
  },
  {
   "start_ms": 142480,
   "end_ms": 143780,
   "text": "ねえそれ今聞くこと"
  },
  {
   "start_ms": 143780,
   "end_ms": 144520,
   "text": "セガは?"
  },
  {
   "start_ms": 144520,
   "end_ms": 145860,
   "text": "セガは?"
  },
  {
   "start_ms": 145860,
   "end_ms": 146520,
   "text": "いや"
  },
  {
   "start_ms": 146520,
   "end_ms": 147020,
   "text": "セガは?"
  },
  {
   "start_ms": 147020,
   "end_ms": 147860,
   "text": "いや…とっくに手伝ってたからね"
  },
  {
   "start_ms": 147860,
   "end_ms": 149140,
   "text": "撤退したけど…"
  },
  {
   "start_ms": 149140,
   "end_ms": 150140,
   "text": "セガは?"
  },
  {
   "start_ms": 150140,
   "end_ms": 153140,
   "text": "いや、セガは?"
  },
  {
   "start_ms": 153140,
   "end_ms": 155140,
   "text": "イキュラスキオラ…"
  },
  {
   "start_ms": 155140,
   "end_ms": 156140,
   "text": "セガは?"
  },
  {
   "start_ms": 156140,
   "end_ms": 159140,
   "text": "ねえ、そのイキュラスキオラって何?"
  },
  {
   "start_ms": 159140,
   "end_ms": 163140,
   "text": "ああ、記憶消去の魔法だな"
  },
  {
   "start_ms": 163140,
   "end_ms": 166140,
   "text": "耐え難いことがあると使うんだ"
  },
  {
   "start_ms": 166140,
   "end_ms": 168140,
   "text": "セガの剣ってそんなに?"
  },
  {
   "start_ms": 168140,
   "end_ms": 171140,
   "text": "異世界は辛いことが多くてなあ"
  },
  {
   "start_ms": 171140,
   "end_ms": 172140,
   "text": "見るか?"
  },
  {
   "start_ms": 172140,
   "end_ms": 174140,
   "text": "ん、うん"
  },
  {
   "start_ms": 177860,
   "end_ms": 180000,
   "text": "ああああああ"
  }
 ],
