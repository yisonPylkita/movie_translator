 "segments": [
  {
   "start_ms": 0,
   "end_ms": 8960,
   "text": "You're Takafumi, my sister's kid."
  },
  {
   "start_ms": 8960,
   "end_ms": 11360,
   "text": "But where is..."
  },
  {
   "start_ms": 11360,
   "end_ms": 13320,
   "text": "everyone else?"
  },
  {
   "start_ms": 13320,
   "end_ms": 19060,
   "text": "Well, our family had a huge falling out because of you."
  },
  {
   "start_ms": 19060,
   "end_ms": 21580,
   "text": "What to do with you while you were in a coma."
  },
  {
   "start_ms": 21580,
   "end_ms": 23520,
   "text": "And let me tell you, it wasn't cheap."
  },
  {
   "start_ms": 23520,
   "end_ms": 27820,
   "text": "My mom said she didn't want to see you."
  },
  {
   "start_ms": 30000,
   "end_ms": 32000,
   "text": "So..."
  },
  {
   "start_ms": 32000,
   "end_ms": 34340,
   "text": "Ikuras Kuora."
  },
  {
   "start_ms": 34340,
   "end_ms": 38320,
   "text": "Okay."
  },
  {
   "start_ms": 38320,
   "end_ms": 41960,
   "text": "I'll prove Gran Bahamal is real."
  },
  {
   "start_ms": 41960,
   "end_ms": 45460,
   "text": "Uh, you really don't..."
  },
  {
   "start_ms": 45460,
   "end_ms": 46980,
   "text": "Wargrant Seld."
  },
  {
   "start_ms": 46980,
   "end_ms": 51040,
   "text": "Okay."
  },
  {
   "start_ms": 51040,
   "end_ms": 53560,
   "text": "Wargrant Magna."
  },
  {
   "start_ms": 53560,
   "end_ms": 58400,
   "text": "Wargrant Rald."
  },
  {
   "start_ms": 58400,
   "end_ms": 59340,
   "text": "This is..."
  },
  {
   "start_ms": 59340,
   "end_ms": 59980,
   "text": "Wargrant Necron."
  },
  {
   "start_ms": 60000,
   "end_ms": 60600,
   "text": "Just sad."
  },
  {
   "start_ms": 60600,
   "end_ms": 62160,
   "text": "Wargrant Gan."
  },
  {
   "start_ms": 62160,
   "end_ms": 63660,
   "text": "Wargrant Pat."
  },
  {
   "start_ms": 63660,
   "end_ms": 64860,
   "text": "Hey, Uncle."
  },
  {
   "start_ms": 64860,
   "end_ms": 65660,
   "text": "Wargrant Lach."
  },
  {
   "start_ms": 65660,
   "end_ms": 67800,
   "text": "Money has been a little tight lately."
  },
  {
   "start_ms": 67800,
   "end_ms": 68440,
   "text": "Wargrant Dragon."
  },
  {
   "start_ms": 68440,
   "end_ms": 70960,
   "text": "So I brought some documents for you to sign."
  },
  {
   "start_ms": 70960,
   "end_ms": 75360,
   "text": "And after that, they're going to send you somewhere to help you get back on your feet."
  },
  {
   "start_ms": 75360,
   "end_ms": 75700,
   "text": "Wind carry."
  },
  {
   "start_ms": 75700,
   "end_ms": 86880,
   "text": "What the hell?"
  },
  {
   "start_ms": 86880,
   "end_ms": 88660,
   "text": "Wind, return it."
  },
  {
   "start_ms": 90000,
   "end_ms": 91260,
   "text": "Wind, return it."
  },
  {
   "start_ms": 91260,
   "end_ms": 93160,
   "text": "Of course, it's Japanese here."
  },
  {
   "start_ms": 93160,
   "end_ms": 109260,
   "text": "It's all real."
  },
  {
   "start_ms": 109260,
   "end_ms": 112640,
   "text": "Hold on now."
  },
  {
   "start_ms": 112640,
   "end_ms": 115480,
   "text": "Did you just say you were sending me away somewhere?"
  },
  {
   "start_ms": 115480,
   "end_ms": 116820,
   "text": "No, I didn't."
  },
  {
   "start_ms": 116820,
   "end_ms": 118420,
   "text": "You sure?"
  },
  {
   "start_ms": 118420,
   "end_ms": 118960,
   "text": "Yeah, yeah."
  },
  {
   "start_ms": 118960,
   "end_ms": 119800,
   "text": "So, what was that?"
  },
  {
   "start_ms": 120000,
   "end_ms": 120260,
   "text": "Hmm."
  },
  {
   "start_ms": 120260,
   "end_ms": 121920,
   "text": "It's magic."
  },
  {
   "start_ms": 121920,
   "end_ms": 123500,
   "text": "Fire."
  },
  {
   "start_ms": 123500,
   "end_ms": 125920,
   "text": "Whoa, awesome."
  },
  {
   "start_ms": 125920,
   "end_ms": 127640,
   "text": "Wait, how are you doing that?"
  },
  {
   "start_ms": 127640,
   "end_ms": 128700,
   "text": "Eh, it's nothing."
  },
  {
   "start_ms": 128700,
   "end_ms": 131440,
   "text": "I want to know if Sega won the console wars."
  },
  {
   "start_ms": 131440,
   "end_ms": 132060,
   "text": "Huh?"
  },
  {
   "start_ms": 132060,
   "end_ms": 133400,
   "text": "Sega?"
  },
  {
   "start_ms": 133400,
   "end_ms": 135120,
   "text": "Now?"
  },
  {
   "start_ms": 135120,
   "end_ms": 140120,
   "text": "Well, these days, Sony and Nintendo are the biggest console makers."
  },
  {
   "start_ms": 140120,
   "end_ms": 141000,
   "text": "Huh?"
  },
  {
   "start_ms": 141000,
   "end_ms": 141740,
   "text": "No Sega?"
  },
  {
   "start_ms": 141740,
   "end_ms": 143960,
   "text": "Is this important?"
  },
  {
   "start_ms": 143960,
   "end_ms": 144400,
   "text": "Sega!"
  },
  {
   "start_ms": 144400,
   "end_ms": 144800,
   "text": "Yeah."
  },
  {
   "start_ms": 144800,
   "end_ms": 148880,
   "text": "Well, they stopped making consoles."
  },
  {
   "start_ms": 150000,
   "end_ms": 151360,
   "text": "They're not even a console."
  },
  {
