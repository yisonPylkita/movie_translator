 "segments": [
  {
   "start_ms": 0,
   "end_ms": 5000,
   "text": "(オラゴン) 姉ちゃんの子供の高踏みか"
  },
  {
   "start_ms": 5000,
   "end_ms": 9000,
   "text": "大きくなったな 他の皆は"
  },
  {
   "start_ms": 9000,
   "end_ms": 15000,
   "text": "(レン) 混水状態のおじさんの食うを巡って"
  },
  {
   "start_ms": 15000,
   "end_ms": 18000,
   "text": "言っちゃいけないことを ボロクスを言い合ったあげく"
  },
  {
   "start_ms": 18000,
   "end_ms": 20000,
   "text": "一家離散したよ"
  },
  {
   "start_ms": 20000,
   "end_ms": 24000,
   "text": "うちの母さんも正直会いたくないって"
  },
  {
   "start_ms": 24000,
   "end_ms": 29000,
   "text": "(レン) もう一度 もう一度"
  },
  {
   "start_ms": 31000,
   "end_ms": 34000,
   "text": "(オラゴン) 生きるらす キュオラ"
  },
  {
   "start_ms": 34000,
   "end_ms": 37000,
   "text": "(レン) ふー"
  },
  {
   "start_ms": 37000,
   "end_ms": 39000,
   "text": "さて"
  },
  {
   "start_ms": 39000,
   "end_ms": 42000,
   "text": "異世界にいた証拠を見せよう"
  },
  {
   "start_ms": 42000,
   "end_ms": 44000,
   "text": "(オラゴン) え? いや いいです"
  },
  {
   "start_ms": 44000,
   "end_ms": 47000,
   "text": "(レン) ワーグレント・セルド"
  },
  {
   "start_ms": 47000,
   "end_ms": 51000,
   "text": "あれ?"
  },
  {
   "start_ms": 51000,
   "end_ms": 53000,
   "text": "ワーグレント・マグナ!"
  },
  {
   "start_ms": 53000,
   "end_ms": 58000,
   "text": "ワーグレント・ラルド!"
  },
  {
   "start_ms": 58000,
   "end_ms": 60000,
   "text": "(レン) 本当? 素材な"
  },
  {
   "start_ms": 60000,
   "end_ms": 62000,
   "text": "(オラゴン) わーグレント・ガッド!"
  },
  {
   "start_ms": 62000,
   "end_ms": 64000,
   "text": "ワーグレント・パッド!"
  },
  {
   "start_ms": 64000,
   "end_ms": 68000,
   "text": "(レン) あのさ 普景機でうちも厳しくてさ"
  },
  {
   "start_ms": 68000,
   "end_ms": 71000,
   "text": "これもいろいろあってバイトしてるし"
  },
  {
   "start_ms": 71000,
   "end_ms": 74000,
   "text": "自立支援とか あれする書類を持ってきたんだけど"
  },
  {
   "start_ms": 74000,
   "end_ms": 76000,
   "text": "(オラゴン) 風を運べ"
  },
  {
   "start_ms": 76000,
   "end_ms": 84000,
   "text": "(レン) ああ"
  },
  {
   "start_ms": 84000,
   "end_ms": 86000,
   "text": "(レン) ああ"
  },
  {
   "start_ms": 86000,
   "end_ms": 88000,
   "text": "(オラゴン) マジかよ!"
  },
  {
   "start_ms": 88000,
   "end_ms": 90000,
   "text": "(レン) 風を戻せ"
  },
  {
   "start_ms": 90000,
   "end_ms": 93000,
   "text": "(レン) こっちじゃ日本語なんだな"
  },
  {
   "start_ms": 93000,
   "end_ms": 96000,
   "text": "(レン) はぁ"
  },
  {
   "start_ms": 96000,
   "end_ms": 98000,
   "text": "(レン) はぁ"
  },
  {
   "start_ms": 98000,
   "end_ms": 100000,
   "text": "(レン) 本物だ"
  },
  {
   "start_ms": 100000,
   "end_ms": 115000,
   "text": "(レン) というか なんか結構エグいことを言おうとしてなかった"
  },
  {
   "start_ms": 115000,
   "end_ms": 117000,
   "text": "(レン) 言ってないよ"
  },
  {
   "start_ms": 117000,
   "end_ms": 118000,
   "text": "(レン) 本当?"
  },
  {
   "start_ms": 118000,
   "end_ms": 120000,
   "text": "(レン) それよりさっきの何?"
  },
  {
   "start_ms": 120000,
   "end_ms": 122000,
   "text": "(レン) 魔法だよ"
  },
  {
   "start_ms": 122000,
   "end_ms": 123000,
   "text": "火を"
  },
  {
   "start_ms": 123000,
   "end_ms": 126000,
   "text": "(レン) あ! すごい!"
  },
  {
   "start_ms": 126000,
   "end_ms": 127000,
   "text": "それどうやって出してるの?"
  },
  {
   "start_ms": 127000,
   "end_ms": 130000,
   "text": "(レン) そんなことより ゲームハードセンスはどうなった?"
  },
  {
   "start_ms": 130000,
   "end_ms": 131000,
   "text": "せがわ"
  },
  {
   "start_ms": 131000,
   "end_ms": 132000,
   "text": "(レン) え?"
  },
  {
   "start_ms": 132000,
   "end_ms": 133000,
   "text": "せが?"
  },
  {
   "start_ms": 133000,
   "end_ms": 135000,
   "text": "い…今"
  },
  {
   "start_ms": 135000,
   "end_ms": 137000,
   "text": "(レン) 国内だと"
  },
  {
   "start_ms": 137000,
   "end_ms": 140000,
   "text": "ソニーとニンテンドーが二挙って感じかな"
  },
  {
   "start_ms": 140000,
   "end_ms": 142000,
   "text": "(レン) はぁ せがわ"
  },
  {
   "start_ms": 142000,
   "end_ms": 143000,
   "text": "(レン) ねぇ それ今…"
  },
  {
   "start_ms": 143000,
   "end_ms": 145000,
   "text": "せがわ?"
  },
  {
   "start_ms": 145000,
   "end_ms": 148000,
   "text": "いや…特に撤退したけど"
  },
  {
   "start_ms": 148000,
   "end_ms": 154000,
   "text": "イキュラスキュラ"
  },
  {
   "start_ms": 154000,
   "end_ms": 158000,
   "text": "ねえ そのイキュラスキュラって何?"
  },
  {
   "start_ms": 158000,
   "end_ms": 160000,
   "text": "(レン) おう"
  },
  {
   "start_ms": 160000,
   "end_ms": 162000,
   "text": "記憶消去の魔法だな"
  },
  {
   "start_ms": 162000,
   "end_ms": 165000,
   "text": "耐え難いことがあると使うんだ"
  },
  {
   "start_ms": 165000,
   "end_ms": 168000,
   "text": "せがの剣って そんなに?"
  },
  {
   "start_ms": 168000,
   "end_ms": 171000,
   "text": "異世界は辛いことが多くてなぁ"
  },
  {
   "start_ms": 171000,
   "end_ms": 173000,
   "text": "見るか"
  },
  {
   "start_ms": 173000,
   "end_ms": 174000,
   "text": "うん"
  }
 ],
