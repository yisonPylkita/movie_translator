 "segments": [
  {
   "start_ms": 6422,
   "end_ms": 8924,
   "text": "You're Takafumi, my sister's kid."
  },
  {
   "start_ms": 9844,
   "end_ms": 13287,
   "text": "But where is everyone else?"
  },
  {
   "start_ms": 16489,
   "end_ms": 19071,
   "text": "Well, our family had a huge falling out because of you."
  },
  {
   "start_ms": 19732,
   "end_ms": 21753,
   "text": "What to do with you while you were in a coma."
  },
  {
   "start_ms": 21973,
   "end_ms": 23534,
   "text": "And let me tell you, it wasn't cheap."
  },
  {
   "start_ms": 25195,
   "end_ms": 27817,
   "text": "My mom said she didn't want to see you."
  },
  {
   "start_ms": 33081,
   "end_ms": 34302,
   "text": "Ikuras Kuora."
  },
  {
   "start_ms": 38074,
   "end_ms": 38635,
   "text": "Okay."
  },
  {
   "start_ms": 39816,
   "end_ms": 41997,
   "text": "I'll prove Grom Baham all is real."
  },
  {
   "start_ms": 42778,
   "end_ms": 47142,
   "text": "Uh, you really don't... Wargrant Sel'd."
  },
  {
   "start_ms": 50764,
   "end_ms": 51185,
   "text": "Okay."
  },
  {
   "start_ms": 52366,
   "end_ms": 53707,
   "text": "Wargrant Magna."
  },
  {
   "start_ms": 57530,
   "end_ms": 58411,
   "text": "Wargrant Rald."
  },
  {
   "start_ms": 58891,
   "end_ms": 60652,
   "text": "This is just sad."
  },
  {
   "start_ms": 61553,
   "end_ms": 62214,
   "text": "Wargrant Gad."
  },
  {
   "start_ms": 63959,
   "end_ms": 71024,
   "text": "Hey, Uncle, money has been a little tight lately, so I brought some documents for you to sign."
  },
  {
   "start_ms": 71865,
   "end_ms": 75868,
   "text": "And after that, they're going to send you somewhere to help you get back on your feet."
  },
  {
   "start_ms": 86116,
   "end_ms": 87818,
   "text": "What the hell?"
  },
  {
   "start_ms": 87838,
   "end_ms": 88658,
   "text": "Wind, return it."
  },
  {
   "start_ms": 91360,
   "end_ms": 91820,
   "text": "Of course."
  },
  {
   "start_ms": 92140,
   "end_ms": 93141,
   "text": "It's Japanese here."
  },
  {
   "start_ms": 108408,
   "end_ms": 111429,
   "text": "It's all real."
  },
  {
   "start_ms": 111669,
   "end_ms": 112690,
   "text": "Hold on now."
  },
  {
   "start_ms": 113110,
   "end_ms": 115711,
   "text": "Did you just say you were sending me away somewhere?"
  },
  {
   "start_ms": 116191,
   "end_ms": 116812,
   "text": "No, I didn't."
  },
  {
   "start_ms": 117932,
   "end_ms": 118552,
   "text": "You sure?"
  },
  {
   "start_ms": 118632,
   "end_ms": 119053,
   "text": "Yeah, yeah."
  },
  {
   "start_ms": 119073,
   "end_ms": 119833,
   "text": "So what was that?"
  },
  {
   "start_ms": 121459,
   "end_ms": 121959,
   "text": "It's magic."
  },
  {
   "start_ms": 123180,
   "end_ms": 123660,
   "text": "Fire."
  },
  {
   "start_ms": 125040,
   "end_ms": 126081,
   "text": "Whoa, awesome!"
  },
  {
   "start_ms": 126421,
   "end_ms": 127661,
   "text": "Wait, how are you doing that?"
  },
  {
   "start_ms": 127821,
   "end_ms": 128821,
   "text": "That's nothing."
  },
  {
   "start_ms": 129322,
   "end_ms": 131422,
   "text": "I want to know if Sega won the console wars."
  },
  {
   "start_ms": 131922,
   "end_ms": 132943,
   "text": "Huh?"
  },
  {
   "start_ms": 133063,
   "end_ms": 134163,
   "text": "Sega?"
  },
  {
   "start_ms": 134903,
   "end_ms": 135203,
   "text": "Now?"
  },
  {
   "start_ms": 136304,
   "end_ms": 140225,
   "text": "Well, these days, Sony and Nintendo are the biggest console makers."
  },
  {
   "start_ms": 140885,
   "end_ms": 141105,
   "text": "Huh?"
  },
  {
   "start_ms": 141245,
   "end_ms": 141886,
   "text": "No Sega?"
  },
  {
   "start_ms": 142666,
   "end_ms": 144266,
   "text": "Is this important?"
  },
  {
   "start_ms": 144286,
   "end_ms": 144907,
   "text": "Sega!"
  },
  {
   "start_ms": 145967,
   "end_ms": 148928,
   "text": "Well, they stopped making consoles."
  },
  {
   "start_ms": 153184,
   "end_ms": 154425,
   "text": "Ikura's Kuora."
  },
  {
   "start_ms": 156386,
   "end_ms": 158907,
   "text": "Hey, Uncle, what's Ikura's Kuora mean?"
  },
  {
   "start_ms": 159788,
   "end_ms": 162569,
   "text": "Oh, it's a memory-erasing spell."
  },
  {
   "start_ms": 163269,
   "end_ms": 164990,
   "text": "So I can forget sad things."
  },
  {
   "start_ms": 166331,
   "end_ms": 168172,
   "text": "Sega was that important?"
  },
  {
   "start_ms": 168592,
   "end_ms": 171134,
   "text": "There were a lot of sad times in Gran Bahamo."
  },
  {
   "start_ms": 171634,
   "end_ms": 172194,
   "text": "Wanna see?"
  },
  {
   "start_ms": 172895,
   "end_ms": 174035,
   "text": "Uh, yeah."
  }
 ],
