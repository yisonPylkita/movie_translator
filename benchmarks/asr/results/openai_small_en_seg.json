 "segments": [
  {
   "start_ms": 0,
   "end_ms": 3000,
   "text": "You're Takafumi, my sister's kid."
  },
  {
   "start_ms": 3000,
   "end_ms": 7000,
   "text": "But where is everyone else?"
  },
  {
   "start_ms": 10000,
   "end_ms": 13000,
   "text": "Well, our family had a huge falling out because of you."
  },
  {
   "start_ms": 13000,
   "end_ms": 18000,
   "text": "What to do with you while you were in a coma, and let me tell you, it wasn't cheap."
  },
  {
   "start_ms": 18000,
   "end_ms": 22000,
   "text": "My mom said she didn't want to see you."
  },
  {
   "start_ms": 22000,
   "end_ms": 25000,
   "text": "I'm sorry, but I'm sorry."
  },
  {
   "start_ms": 25000,
   "end_ms": 29000,
   "text": "My mom said she didn't want to see you."
  },
  {
   "start_ms": 33000,
   "end_ms": 35000,
   "text": "Ikura's Kura."
  },
  {
   "start_ms": 35000,
   "end_ms": 37000,
   "text": "Ah."
  },
  {
   "start_ms": 37000,
   "end_ms": 39000,
   "text": "Okay."
  },
  {
   "start_ms": 39000,
   "end_ms": 42000,
   "text": "I'll prove Grumbahamal is real."
  },
  {
   "start_ms": 42000,
   "end_ms": 45000,
   "text": "Uh, you really don't..."
  },
  {
   "start_ms": 45000,
   "end_ms": 48000,
   "text": "Wargrant Seld!"
  },
  {
   "start_ms": 50000,
   "end_ms": 52000,
   "text": "Okay."
  },
  {
   "start_ms": 52000,
   "end_ms": 55000,
   "text": "Wargrant Magna!"
  },
  {
   "start_ms": 57000,
   "end_ms": 59000,
   "text": "Wargrant Rald?"
  },
  {
   "start_ms": 59000,
   "end_ms": 61000,
   "text": "This is just sad."
  },
  {
   "start_ms": 61000,
   "end_ms": 63000,
   "text": "Wargrant Gadd!"
  },
  {
   "start_ms": 63000,
   "end_ms": 64000,
   "text": "Wargrant Pat!"
  },
  {
   "start_ms": 64000,
   "end_ms": 66000,
   "text": "Hey, Uncle!"
  },
  {
   "start_ms": 66000,
   "end_ms": 72000,
   "text": "Money has been a little tight lately, so I brought some documents for you to sign."
  },
  {
   "start_ms": 72000,
   "end_ms": 76000,
   "text": "And after that, they're going to send you somewhere to help you get back in your feet."
  },
  {
   "start_ms": 83000,
   "end_ms": 86000,
   "text": "What the hell?!"
  },
  {
   "start_ms": 86000,
   "end_ms": 88000,
   "text": "When? Return it."
  },
  {
   "start_ms": 90000,
   "end_ms": 93000,
   "text": "Of course, it's Japanese here."
  },
  {
   "start_ms": 107000,
   "end_ms": 109000,
   "text": "It's all real!"
  },
  {
   "start_ms": 110000,
   "end_ms": 112000,
   "text": "Hold on now."
  },
  {
   "start_ms": 112000,
   "end_ms": 115000,
   "text": "Did you just say you were sending me away somewhere?"
  },
  {
   "start_ms": 115000,
   "end_ms": 117000,
   "text": "No, I didn't."
  },
  {
   "start_ms": 117000,
   "end_ms": 118000,
   "text": "You sure?"
  },
  {
   "start_ms": 118000,
   "end_ms": 120000,
   "text": "Yeah, yeah, so what was that?"
  },
  {
   "start_ms": 120000,
   "end_ms": 122000,
   "text": "It's magic."
  },
  {
   "start_ms": 122000,
   "end_ms": 124000,
   "text": "Fire."
  },
  {
   "start_ms": 124000,
   "end_ms": 126000,
   "text": "Whoa, awesome!"
  },
  {
   "start_ms": 126000,
   "end_ms": 127000,
   "text": "Wait, how are you doing that?"
  },
  {
   "start_ms": 127000,
   "end_ms": 128000,
   "text": "That's nothing."
  },
  {
   "start_ms": 128000,
   "end_ms": 131000,
   "text": "I want to know if Sega won the console wars."
  },
  {
   "start_ms": 131000,
   "end_ms": 132000,
   "text": "Huh?"
  },
  {
   "start_ms": 132000,
   "end_ms": 133000,
   "text": "Sega?"
  },
  {
   "start_ms": 133000,
   "end_ms": 135000,
   "text": "Now?"
  },
  {
   "start_ms": 135000,
   "end_ms": 140000,
   "text": "Well, these days, Sony and Nintendo are the biggest console makers."
  },
  {
   "start_ms": 140000,
   "end_ms": 142000,
   "text": "Huh? No Sega?"
  },
  {
   "start_ms": 142000,
   "end_ms": 144000,
   "text": "Is this some sort of..."
  },
  {
   "start_ms": 144000,
   "end_ms": 145000,
   "text": "Sega!"
  },
  {
   "start_ms": 145000,
   "end_ms": 149000,
   "text": "Well, they stopped making consoles."
  },
  {
   "start_ms": 152000,
   "end_ms": 155000,
   "text": "Ikura's Kura."
  },
  {
   "start_ms": 155000,
   "end_ms": 159000,
   "text": "Hey, Uncle, what's Ikura's Kura mean?"
  },
  {
   "start_ms": 159000,
   "end_ms": 162000,
   "text": "Oh, it's a memory erasing spell."
  },
  {
   "start_ms": 162000,
   "end_ms": 165000,
   "text": "So I can forget sad things."
  },
  {
   "start_ms": 165000,
   "end_ms": 168000,
   "text": "Sega was that important?"
  },
  {
   "start_ms": 168000,
   "end_ms": 171000,
   "text": "There were a lot of sad times in Grand Bahamut."
  },
  {
   "start_ms": 171000,
   "end_ms": 172000,
   "text": "Wanna see?"
  },
  {
   "start_ms": 172000,
   "end_ms": 174000,
   "text": "Uh, yeah."
  }
 ],
